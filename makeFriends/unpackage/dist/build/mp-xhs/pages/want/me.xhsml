<view class="container data-v-8b3e94c0"><view xhs:if="{{a}}" class="empty data-v-8b3e94c0"><text class="empty-icon data-v-8b3e94c0">💝</text><text class="empty-text data-v-8b3e94c0">暂无记录</text><text class="empty-tip data-v-8b3e94c0">完善资料，吸引更多人关注你</text><navigator class="empty-btn data-v-8b3e94c0" url="/pages/profile/edit">完善资料</navigator></view><view xhs:else class="list data-v-8b3e94c0"><view xhs:for="{{b}}" xhs:for-item="item" xhs:key="k" class="list-item data-v-8b3e94c0" bindtap="{{item.l}}"><image class="avatar data-v-8b3e94c0" src="{{item.a}}" mode="aspectFill"></image><view class="info data-v-8b3e94c0"><view class="info-top data-v-8b3e94c0"><text class="nickname data-v-8b3e94c0">{{item.b}}</text><text class="{{('gender') + ' ' + 'data-v-8b3e94c0' + ' ' + (item.d && 'female')}}">{{item.c}}</text></view><text class="desc data-v-8b3e94c0">{{item.e}}岁 · {{item.f}}cm · {{item.g}}</text><text class="time data-v-8b3e94c0">{{item.h}}</text></view><view class="{{('want-type') + ' ' + 'data-v-8b3e94c0' + ' ' + item.j}}"> 想看{{item.i}}</view></view></view><view xhs:if="{{c}}" class="load-more data-v-8b3e94c0"><text xhs:if="{{d}}" class="data-v-8b3e94c0">加载中...</text><text xhs:elif="{{e}}" class="data-v-8b3e94c0">没有更多了</text><text xhs:else class="data-v-8b3e94c0" bindtap="{{f}}">点击加载更多</text></view></view>