<view class="container data-v-4b927650"><view xhs:if="{{a}}" class="not-login data-v-4b927650"><view class="login-prompt data-v-4b927650"><image class="prompt-icon data-v-4b927650" src="{{b}}" mode="aspectFit"></image><text class="prompt-title data-v-4b927650">登录后查看更多内容</text><text class="prompt-desc data-v-4b927650">登录后可查看个人信息、互动消息等</text><button class="login-btn data-v-4b927650" bindtap="{{c}}">立即登录</button></view></view><view xhs:else class="data-v-4b927650"><view class="user-section data-v-4b927650"><view class="user-header data-v-4b927650"><view class="avatar-container data-v-4b927650" bindtap="{{e}}"><image class="avatar data-v-4b927650" src="{{d}}" mode="aspectFill"></image><button class="change-avatar-btn data-v-4b927650">更换头像</button></view><view class="user-info-container data-v-4b927650"><view class="user-content data-v-4b927650"><text class="user-name data-v-4b927650">{{f}}</text><navigator class="edit-profile data-v-4b927650" url="/pages/profile/edit">编辑资料</navigator></view></view></view></view><view xhs:if="{{g}}" class="profile-tip data-v-4b927650"><text class="tip-text data-v-4b927650">资料完善度{{h}}%，完善资料获得曝光</text><navigator class="tip-btn data-v-4b927650" url="/pages/profile/edit">去完善 &gt;</navigator></view><view class="stats-section data-v-4b927650"><navigator class="stat-card data-v-4b927650" url="/pages/visited/index"><text class="stat-number data-v-4b927650">{{i}}</text><text class="stat-label data-v-4b927650">最近来访</text></navigator><navigator class="stat-card data-v-4b927650" url="/pages/fans/index"><text class="stat-number data-v-4b927650">{{j}}</text><text class="stat-label data-v-4b927650">喜欢我的人</text></navigator><navigator class="stat-card data-v-4b927650" url="/pages/like/index"><text class="stat-number data-v-4b927650">{{k}}</text><text class="stat-label data-v-4b927650">我喜欢的人</text></navigator></view><navigator class="coin-section data-v-4b927650" url="/pages/coin/index"><view class="coin-info data-v-4b927650"><text class="coin-title data-v-4b927650">我的脱单币</text><view class="coin-amount-container data-v-4b927650"><text class="coin-amount data-v-4b927650">{{l}}</text><text class="coin-dot data-v-4b927650">•</text></view></view><button class="get-more-btn data-v-4b927650">获取更多</button></navigator><view class="feature-icons-section data-v-4b927650"><navigator class="feature-icon-item data-v-4b927650" url="/pages/want/my"><view class="feature-icon heart data-v-4b927650">❤️</view><text class="feature-text data-v-4b927650">我想看的</text></navigator><navigator class="feature-icon-item data-v-4b927650" url="/pages/want/me"><view class="feature-icon smile data-v-4b927650">😊</view><text class="feature-text data-v-4b927650">想看我的</text></navigator><navigator class="feature-icon-item data-v-4b927650" url="/pages/soul/questions"><view class="feature-icon question data-v-4b927650">❓</view><text class="feature-text data-v-4b927650">灵魂3问</text></navigator></view><view class="bottom-features-section data-v-4b927650"><navigator class="bottom-feature-item group data-v-4b927650" url="/pages/group/index"><view class="bottom-icon data-v-4b927650">👥</view><text class="bottom-text data-v-4b927650">同城单身群</text></navigator><navigator class="bottom-feature-item setting data-v-4b927650" url="/pages/setting/index"><view class="bottom-icon data-v-4b927650">⚙️</view><text class="bottom-text data-v-4b927650">设置</text></navigator><navigator class="bottom-feature-item verify data-v-4b927650" url="/pages/auth/index"><view class="bottom-icon data-v-4b927650">✅</view><text class="bottom-text data-v-4b927650">认证</text></navigator></view></view></view>