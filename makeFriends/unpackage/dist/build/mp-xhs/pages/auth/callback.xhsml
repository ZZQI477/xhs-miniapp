<view class="container data-v-0806487c"><view class="{{('result-icon') + ' ' + 'data-v-0806487c' + ' ' + d}}"><text xhs:if="{{a}}" class="data-v-0806487c">...</text><text xhs:if="{{b}}" class="data-v-0806487c">✓</text><text xhs:if="{{c}}" class="data-v-0806487c">✕</text></view><text class="result-title data-v-0806487c">{{e}}</text><text class="result-desc data-v-0806487c">{{f}}</text><button xhs:if="{{g}}" class="submit-btn data-v-0806487c" bindtap="{{h}}">查询认证结果</button><button xhs:if="{{i}}" class="submit-btn data-v-0806487c" bindtap="{{j}}">重新认证</button><button xhs:if="{{k}}" class="submit-btn success data-v-0806487c" bindtap="{{l}}">返回认证中心</button></view>