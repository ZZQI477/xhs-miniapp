<view class="container data-v-43656fbb"><view class="tabs data-v-43656fbb"><view class="{{('tab-item') + ' ' + 'data-v-43656fbb' + ' ' + (c && 'active')}}" bindtap="{{d}}"> 收到的申请 <view xhs:if="{{a}}" class="badge data-v-43656fbb">{{b}}</view></view><view class="{{('tab-item') + ' ' + 'data-v-43656fbb' + ' ' + (e && 'active')}}" bindtap="{{f}}"> 发出的申请 </view></view><view xhs:if="{{g}}" class="empty data-v-43656fbb"><text class="empty-icon data-v-43656fbb">💌</text><text class="empty-text data-v-43656fbb">暂无{{h}}的申请</text></view><view xhs:if="{{i}}" class="list data-v-43656fbb"><view xhs:for="{{j}}" xhs:for-item="item" xhs:key="q" class="list-item data-v-43656fbb"><view class="item-main data-v-43656fbb" bindtap="{{item.k}}"><image class="avatar data-v-43656fbb" src="{{item.a}}" mode="aspectFill"></image><view class="info data-v-43656fbb"><view class="info-top data-v-43656fbb"><text class="nickname data-v-43656fbb">{{item.b}}</text><text class="{{('gender') + ' ' + 'data-v-43656fbb' + ' ' + (item.d && 'female')}}">{{item.c}}</text></view><text class="desc data-v-43656fbb">{{item.e}}岁 · {{item.f}}cm · {{item.g}}</text><text xhs:if="{{item.h}}" class="message data-v-43656fbb">{{item.i}}</text><text class="time data-v-43656fbb">{{item.j}}</text></view></view><view xhs:if="{{item.l}}" class="actions data-v-43656fbb"><button class="btn reject data-v-43656fbb" bindtap="{{item.m}}">拒绝</button><button class="btn accept data-v-43656fbb" bindtap="{{item.n}}">同意</button></view><view xhs:else class="status-text data-v-43656fbb"><text xhs:if="{{item.o}}" class="accepted data-v-43656fbb">已同意</text><text xhs:elif="{{item.p}}" class="rejected data-v-43656fbb">已拒绝</text></view></view></view><view xhs:if="{{k}}" class="list data-v-43656fbb"><view xhs:for="{{l}}" xhs:for-item="item" xhs:key="m" class="list-item data-v-43656fbb" bindtap="{{item.n}}"><view class="item-main data-v-43656fbb"><image class="avatar data-v-43656fbb" src="{{item.a}}" mode="aspectFill"></image><view class="info data-v-43656fbb"><view class="info-top data-v-43656fbb"><text class="nickname data-v-43656fbb">{{item.b}}</text><text class="{{('gender') + ' ' + 'data-v-43656fbb' + ' ' + (item.d && 'female')}}">{{item.c}}</text></view><text class="desc data-v-43656fbb">{{item.e}}岁 · {{item.f}}cm · {{item.g}}</text><text xhs:if="{{item.h}}" class="message data-v-43656fbb">{{item.i}}</text><text class="time data-v-43656fbb">{{item.j}}</text></view></view><view class="{{('status-tag') + ' ' + 'data-v-43656fbb' + ' ' + item.l}}">{{item.k}}</view></view></view><view xhs:if="{{m}}" class="load-more data-v-43656fbb"><text xhs:if="{{n}}" class="data-v-43656fbb">加载中...</text><text xhs:elif="{{o}}" class="data-v-43656fbb">没有更多了</text><text xhs:else class="data-v-43656fbb" bindtap="{{p}}">点击加载更多</text></view></view>