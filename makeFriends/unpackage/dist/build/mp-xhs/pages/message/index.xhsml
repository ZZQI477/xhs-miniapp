<view class="container data-v-7927b3d4"><view class="tabs data-v-7927b3d4"><view xhs:for="{{a}}" xhs:for-item="tab" xhs:key="d" class="{{('tab-item') + ' ' + 'data-v-7927b3d4' + ' ' + (tab.e && 'active')}}" bindtap="{{tab.f}}">{{tab.a}} <view xhs:if="{{tab.b}}" class="badge data-v-7927b3d4">{{tab.c}}</view></view></view><view xhs:if="{{b}}" class="action-bar data-v-7927b3d4"><text class="action-btn data-v-7927b3d4" bindtap="{{c}}">全部已读</text><text class="action-btn danger data-v-7927b3d4" bindtap="{{d}}">清空</text></view><view xhs:if="{{e}}" class="empty data-v-7927b3d4"><text class="empty-icon data-v-7927b3d4">📭</text><text class="empty-text data-v-7927b3d4">暂无消息</text></view><view xhs:else class="list data-v-7927b3d4"><view xhs:for="{{f}}" xhs:for-item="item" xhs:key="l" class="{{('message-item') + ' ' + 'data-v-7927b3d4' + ' ' + (item.m && 'unread')}}" bindtap="{{item.n}}"><view class="{{('message-icon') + ' ' + 'data-v-7927b3d4' + ' ' + item.c}}"><text xhs:if="{{item.a}}" class="data-v-7927b3d4">💌</text><text xhs:elif="{{item.b}}" class="data-v-7927b3d4">👀</text><text xhs:else class="data-v-7927b3d4">📢</text></view><view class="message-content data-v-7927b3d4"><view class="message-header data-v-7927b3d4"><text class="message-title data-v-7927b3d4">{{item.d}}</text><text class="message-time data-v-7927b3d4">{{item.e}}</text></view><text class="message-desc data-v-7927b3d4">{{item.f}}</text><view xhs:if="{{item.g}}" class="from-user data-v-7927b3d4" catchtap="{{item.j}}"><image class="from-avatar data-v-7927b3d4" src="{{item.h}}" mode="aspectFill"></image><text class="from-name data-v-7927b3d4">{{item.i}}</text><text class="view-btn data-v-7927b3d4">查看 →</text></view></view><view xhs:if="{{item.k}}" class="unread-dot data-v-7927b3d4"></view></view></view><view xhs:if="{{g}}" class="load-more data-v-7927b3d4"><text xhs:if="{{h}}" class="data-v-7927b3d4">加载中...</text><text xhs:elif="{{i}}" class="data-v-7927b3d4">没有更多了</text><text xhs:else class="data-v-7927b3d4" bindtap="{{j}}">点击加载更多</text></view></view>