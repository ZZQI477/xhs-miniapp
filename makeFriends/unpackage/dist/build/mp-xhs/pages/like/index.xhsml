<view class="container data-v-584cf000"><view class="tabs data-v-584cf000"><view class="{{('tab-item') + ' ' + 'data-v-584cf000' + ' ' + (a && 'active')}}" bindtap="{{b}}"><text class="tab-text data-v-584cf000">已认证用户</text></view><view class="{{('tab-item') + ' ' + 'data-v-584cf000' + ' ' + (c && 'active')}}" bindtap="{{d}}"><text class="tab-text data-v-584cf000">未认证用户</text></view></view><view class="user-list data-v-584cf000"><view xhs:for="{{e}}" xhs:for-item="user" xhs:key="h" class="user-item data-v-584cf000" bindtap="{{user.i}}"><image class="user-avatar data-v-584cf000" src="{{user.a}}" mode="aspectFill"></image><view class="user-info data-v-584cf000"><view class="user-name data-v-584cf000"><text class="name data-v-584cf000">{{user.b}}</text><text xhs:if="{{user.c}}" class="certified-icon data-v-584cf000">✓</text></view><text class="user-details data-v-584cf000">{{user.d}}岁 {{user.e}} {{user.f}}cm</text></view><button class="cancel-follow-btn data-v-584cf000" catchtap="{{user.g}}">取消关注</button></view></view><view xhs:if="{{f}}" class="load-more data-v-584cf000" bindtap="{{h}}"><text class="data-v-584cf000">{{g}}</text></view><view xhs:if="{{i}}" class="empty data-v-584cf000"><text class="data-v-584cf000">暂无关注</text></view></view>