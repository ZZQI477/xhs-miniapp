<view class="container data-v-9b8c4c75"><view class="tabs data-v-9b8c4c75"><view class="{{('tab-item') + ' ' + 'data-v-9b8c4c75' + ' ' + (a && 'active')}}" bindtap="{{b}}"><text class="tab-text data-v-9b8c4c75">已认证用户</text></view><view class="{{('tab-item') + ' ' + 'data-v-9b8c4c75' + ' ' + (c && 'active')}}" bindtap="{{d}}"><text class="tab-text data-v-9b8c4c75">未认证用户</text></view></view><view class="user-list data-v-9b8c4c75"><view xhs:for="{{e}}" xhs:for-item="user" xhs:key="h" class="user-item data-v-9b8c4c75" bindtap="{{user.i}}"><image class="user-avatar data-v-9b8c4c75" src="{{user.a}}" mode="aspectFill"></image><view class="user-info data-v-9b8c4c75"><view class="user-name data-v-9b8c4c75"><text class="name data-v-9b8c4c75">{{user.b}}</text><text xhs:if="{{user.c}}" class="certified-icon data-v-9b8c4c75">✓</text></view><text class="user-details data-v-9b8c4c75">{{user.d}}岁 {{user.e}} {{user.f}}cm</text><text class="visit-time data-v-9b8c4c75">{{user.g}}来访</text></view></view></view><view xhs:if="{{f}}" class="load-more data-v-9b8c4c75" bindtap="{{h}}"><text class="data-v-9b8c4c75">{{g}}</text></view><view xhs:if="{{i}}" class="empty data-v-9b8c4c75"><text class="data-v-9b8c4c75">暂无访客</text></view></view>