<view class="container data-v-9e8e82c0"><view xhs:if="{{a}}" class="loading data-v-9e8e82c0"><text class="data-v-9e8e82c0">加载中...</text></view><view xhs:if="{{b}}" class="card data-v-9e8e82c0"><view class="top-banner data-v-9e8e82c0"><image class="data-v-9e8e82c0" src="{{c}}" mode="aspectFill"></image><view class="banner-overlay data-v-9e8e82c0"></view><button class="share-btn data-v-9e8e82c0" type="default" size="mini" open-type="share"><text class="data-v-9e8e82c0">分享</text></button><view class="avatar-container data-v-9e8e82c0" bindtap="{{f}}"><image class="avatar data-v-9e8e82c0" src="{{d}}" mode="aspectFill"></image><view xhs:if="{{e}}" class="verified-badge data-v-9e8e82c0"><text class="data-v-9e8e82c0">✓</text></view></view></view><view class="user-info data-v-9e8e82c0"><view class="name-age data-v-9e8e82c0"><text class="name data-v-9e8e82c0">{{g}}</text><text class="age data-v-9e8e82c0">{{h}}岁</text></view><view class="info-tags data-v-9e8e82c0"><text xhs:if="{{i}}" class="info-tag data-v-9e8e82c0">{{j}}cm</text><text xhs:if="{{k}}" class="info-tag data-v-9e8e82c0">{{l}}</text><text xhs:if="{{m}}" class="info-tag data-v-9e8e82c0">{{n}}</text></view><view xhs:if="{{o}}" class="certification data-v-9e8e82c0"><text class="section-title data-v-9e8e82c0">我的认证</text><view class="cert-list data-v-9e8e82c0"><view xhs:if="{{p}}" class="cert-item data-v-9e8e82c0"><text class="cert-icon data-v-9e8e82c0">🪪</text><text class="cert-text data-v-9e8e82c0">实名认证</text></view><view xhs:if="{{q}}" class="cert-item data-v-9e8e82c0"><text class="cert-icon data-v-9e8e82c0">👤</text><text class="cert-text data-v-9e8e82c0">真人认证</text></view><view xhs:if="{{r}}" class="cert-item data-v-9e8e82c0"><text class="cert-icon data-v-9e8e82c0">🎓</text><text class="cert-text data-v-9e8e82c0">学历认证</text></view></view></view><view class="detail-info data-v-9e8e82c0"><text class="section-title data-v-9e8e82c0">基本信息</text><view class="info-grid data-v-9e8e82c0"><view xhs:if="{{s}}" class="info-item data-v-9e8e82c0"><text class="label data-v-9e8e82c0">身高</text><text class="value data-v-9e8e82c0">{{t}}cm</text></view><view xhs:if="{{v}}" class="info-item data-v-9e8e82c0"><text class="label data-v-9e8e82c0">现居</text><text class="value data-v-9e8e82c0">{{w}}</text></view><view xhs:if="{{x}}" class="info-item data-v-9e8e82c0"><text class="label data-v-9e8e82c0">家乡</text><text class="value data-v-9e8e82c0">{{y}}{{z}}</text></view><view xhs:if="{{A}}" class="info-item data-v-9e8e82c0"><text class="label data-v-9e8e82c0">学历</text><text class="value data-v-9e8e82c0">{{B}}</text></view><view xhs:if="{{C}}" class="info-item data-v-9e8e82c0"><text class="label data-v-9e8e82c0">职业</text><text class="value data-v-9e8e82c0">{{D}}</text></view><view xhs:if="{{E}}" class="info-item data-v-9e8e82c0"><text class="label data-v-9e8e82c0">学校</text><text class="value data-v-9e8e82c0">{{F}}</text></view></view></view><view xhs:if="{{G}}" class="introduction data-v-9e8e82c0"><text class="section-title data-v-9e8e82c0">自我介绍</text><text class="intro-text data-v-9e8e82c0">{{H}}</text></view><view xhs:if="{{I}}" class="tags-section data-v-9e8e82c0"><text class="section-title data-v-9e8e82c0">我的标签</text><view class="tags-container data-v-9e8e82c0"><text xhs:for="{{J}}" xhs:for-item="tag" xhs:key="b" class="tag data-v-9e8e82c0">{{tag.a}}</text></view></view><view xhs:if="{{K}}" class="photos-section data-v-9e8e82c0"><text class="section-title data-v-9e8e82c0">我的照片</text><view class="photo-list data-v-9e8e82c0"><view xhs:for="{{L}}" xhs:for-item="img" xhs:key="b" class="photo-container data-v-9e8e82c0" bindtap="{{img.c}}"><image class="data-v-9e8e82c0" src="{{img.a}}" mode="aspectFill"></image></view></view></view><view xhs:if="{{M}}" class="soul-section data-v-9e8e82c0"><text class="section-title data-v-9e8e82c0">灵魂问答</text><view xhs:for="{{N}}" xhs:for-item="item" xhs:key="c" class="soul-item data-v-9e8e82c0"><text class="soul-question data-v-9e8e82c0">Q: {{item.a}}</text><text class="soul-answer data-v-9e8e82c0">A: {{item.b}}</text></view></view><view xhs:if="{{O}}" class="ideal-section data-v-9e8e82c0"><text class="section-title data-v-9e8e82c0">理想对象</text><text xhs:if="{{P}}" class="ideal-text data-v-9e8e82c0">{{Q}}</text><view xhs:if="{{R}}" class="ideal-tags data-v-9e8e82c0"><text xhs:for="{{S}}" xhs:for-item="tag" xhs:key="b" class="tag ideal data-v-9e8e82c0">{{tag.a}}</text></view></view><view class="privacy-section data-v-9e8e82c0"><text class="section-title data-v-9e8e82c0">隐私信息</text><view class="privacy-info data-v-9e8e82c0"><view class="info-item data-v-9e8e82c0"><text class="label data-v-9e8e82c0">有车</text><text class="value data-v-9e8e82c0">{{T}}</text></view><view class="info-item data-v-9e8e82c0"><text class="label data-v-9e8e82c0">有房</text><text class="value data-v-9e8e82c0">{{U}}</text></view><view class="info-item data-v-9e8e82c0"><text class="label data-v-9e8e82c0">微信号</text><text class="{{('value') + ' ' + 'data-v-9e8e82c0' + ' ' + (W && 'locked')}}">{{V}}</text></view></view></view></view></view><view xhs:if="{{X}}" class="empty data-v-9e8e82c0"><text class="data-v-9e8e82c0">用户不存在</text></view><view xhs:if="{{Y}}" class="action-buttons data-v-9e8e82c0"><view class="action-btn follow data-v-9e8e82c0" bindtap="{{ab}}"><text class="btn-icon data-v-9e8e82c0">{{Z}}</text><text class="btn-text data-v-9e8e82c0">{{aa}}</text></view><view class="action-btn contact data-v-9e8e82c0" bindtap="{{ac}}"><text class="btn-icon data-v-9e8e82c0">💬</text><text class="btn-text data-v-9e8e82c0">联系</text></view><view class="action-btn service data-v-9e8e82c0" bindtap="{{ad}}"><text class="btn-icon data-v-9e8e82c0">📞</text><text class="btn-text data-v-9e8e82c0">客服</text></view><view class="action-btn want data-v-9e8e82c0" bindtap="{{ae}}"><text class="btn-icon data-v-9e8e82c0">🔔</text><text class="btn-text data-v-9e8e82c0">想看</text></view></view></view>