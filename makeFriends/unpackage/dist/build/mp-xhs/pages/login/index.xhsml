<view class="container data-v-80b11510"><view class="logo-section data-v-80b11510"><text class="app-name data-v-80b11510">告白时刻Daily</text><text class="app-slogan data-v-80b11510">遇见对的人，开启幸福之旅</text></view><view class="login-tabs data-v-80b11510"><view class="{{('tab-item') + ' ' + 'data-v-80b11510' + ' ' + (a && 'active')}}" bindtap="{{b}}"><text class="data-v-80b11510">验证码登录</text></view><view class="{{('tab-item') + ' ' + 'data-v-80b11510' + ' ' + (c && 'active')}}" bindtap="{{d}}"><text class="data-v-80b11510">密码登录</text></view></view><view class="form-section data-v-80b11510"><view class="input-group data-v-80b11510"><text class="input-label data-v-80b11510">手机号</text><view class="input-wrapper data-v-80b11510"><text class="country-code data-v-80b11510">+86</text><input class="input-field data-v-80b11510" type="number" placeholder="请输入手机号" maxlength="11" value="{{e}}" bindinput="{{f}}"/></view></view><view xhs:if="{{g}}" class="input-group data-v-80b11510"><text class="input-label data-v-80b11510">验证码</text><view class="input-wrapper code-wrapper data-v-80b11510"><input class="input-field data-v-80b11510" type="number" placeholder="请输入验证码" maxlength="6" value="{{h}}" bindinput="{{i}}"/><button class="code-btn data-v-80b11510" disabled="{{k}}" bindtap="{{l}}">{{j}}</button></view></view><view xhs:if="{{m}}" class="input-group data-v-80b11510"><text class="input-label data-v-80b11510">密码</text><view class="input-wrapper data-v-80b11510"><block xhs:if="{{r0}}"><input class="input-field data-v-80b11510" type="{{n}}" placeholder="请输入密码" value="{{o}}" bindinput="{{p}}"/></block><text class="eye-icon data-v-80b11510" bindtap="{{r}}">{{q}}</text></view></view><button class="login-btn data-v-80b11510" loading="{{s}}" bindtap="{{t}}"> 登录 </button><view xhs:if="{{v}}" class="forgot-password data-v-80b11510"><text class="data-v-80b11510" bindtap="{{w}}">忘记密码?</text></view><view xhs:if="{{x}}" class="third-login data-v-80b11510"><view class="divider data-v-80b11510"><view class="divider-line data-v-80b11510"></view><text class="divider-text data-v-80b11510">快捷登录</text><view class="divider-line data-v-80b11510"></view></view><button class="xhs-login-btn data-v-80b11510" loading="{{y}}" bindtap="{{z}}"><view class="xhs-icon-text data-v-80b11510">书</view><text class="data-v-80b11510">小红书一键登录</text></button></view></view><view class="agreement data-v-80b11510"><view class="checkbox-wrapper data-v-80b11510" bindtap="{{C}}"><view class="{{('checkbox') + ' ' + 'data-v-80b11510' + ' ' + (B && 'checked')}}"><text xhs:if="{{A}}" class="data-v-80b11510">✓</text></view></view><text class="agreement-text data-v-80b11510"> 登录即代表同意 <text class="link data-v-80b11510" catchtap="{{D}}">《用户协议》</text> 和 <text class="link data-v-80b11510" catchtap="{{E}}">《隐私政策》</text></text></view></view>