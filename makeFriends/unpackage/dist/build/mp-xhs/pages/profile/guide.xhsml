<view class="container data-v-dbf35b0d"><view class="step-indicator data-v-dbf35b0d"><view xhs:for="{{a}}" xhs:for-item="i" xhs:key="d" class="{{('step-item') + ' ' + 'data-v-dbf35b0d' + ' ' + (i.e && 'active') + ' ' + (i.f && 'done')}}"><view class="step-dot data-v-dbf35b0d"><text xhs:if="{{i.a}}" class="data-v-dbf35b0d">✓</text><text xhs:else class="data-v-dbf35b0d">{{i.b}}</text></view><text class="step-label data-v-dbf35b0d">{{i.c}}</text></view><view class="step-line data-v-dbf35b0d" style="{{'width:' + b}}"></view></view><view xhs:if="{{c}}" class="step-content data-v-dbf35b0d"><view class="step-title data-v-dbf35b0d">填写基础信息</view><view class="step-desc data-v-dbf35b0d">让大家更好地认识你</view><view class="form-section data-v-dbf35b0d"><view class="form-item data-v-dbf35b0d"><text class="label required data-v-dbf35b0d">昵称</text><input class="input data-v-dbf35b0d" placeholder="请输入昵称" maxlength="20" value="{{d}}" bindinput="{{e}}"/></view><view class="form-item data-v-dbf35b0d"><text class="label required data-v-dbf35b0d">性别</text><view class="gender-cards data-v-dbf35b0d"><view class="{{('gender-card') + ' ' + 'data-v-dbf35b0d' + ' ' + (f && 'active')}}" bindtap="{{g}}"><text class="gender-icon data-v-dbf35b0d">👨</text><text class="gender-text data-v-dbf35b0d">男</text></view><view class="{{('gender-card') + ' ' + 'data-v-dbf35b0d' + ' ' + (h && 'active')}}" bindtap="{{i}}"><text class="gender-icon data-v-dbf35b0d">👩</text><text class="gender-text data-v-dbf35b0d">女</text></view></view></view><view class="form-item data-v-dbf35b0d" bindtap="{{l}}"><text class="label required data-v-dbf35b0d">出生年份</text><text class="{{('value') + ' ' + 'data-v-dbf35b0d' + ' ' + (k && 'placeholder')}}">{{j}}</text><text class="arrow data-v-dbf35b0d">→</text></view><view class="form-item data-v-dbf35b0d" bindtap="{{o}}"><text class="label required data-v-dbf35b0d">身高</text><text class="{{('value') + ' ' + 'data-v-dbf35b0d' + ' ' + (n && 'placeholder')}}">{{m}}</text><text class="arrow data-v-dbf35b0d">→</text></view></view></view><view xhs:if="{{p}}" class="step-content data-v-dbf35b0d"><view class="step-title data-v-dbf35b0d">手机号验证</view><view class="step-desc data-v-dbf35b0d">用于接收重要通知</view><view class="phone-section data-v-dbf35b0d"><view xhs:if="{{q}}" class="phone-verified data-v-dbf35b0d"><text class="verified-icon data-v-dbf35b0d">✓</text><view class="verified-info data-v-dbf35b0d"><text class="phone-number data-v-dbf35b0d">{{r}}</text><text class="verified-text data-v-dbf35b0d">手机号已验证</text></view></view><view xhs:else class="phone-unverified data-v-dbf35b0d"><text class="unverified-icon data-v-dbf35b0d">📱</text><text class="unverified-text data-v-dbf35b0d">您已通过手机号登录，无需再次验证</text></view></view></view><view xhs:if="{{s}}" class="step-content data-v-dbf35b0d"><view class="step-title data-v-dbf35b0d">描述你的理想型</view><view class="step-desc data-v-dbf35b0d">帮助系统更精准匹配</view><view class="form-section data-v-dbf35b0d"><view class="textarea-section data-v-dbf35b0d"><text class="textarea-label required data-v-dbf35b0d">理想对象描述</text><block xhs:if="{{r0}}"><textarea class="textarea data-v-dbf35b0d" placeholder="描述一下你理想中的Ta，如年龄、性格、职业、爱好等偏好..." maxlength="500" value="{{t}}" bindinput="{{v}}"/></block><text class="{{('char-count') + ' ' + 'data-v-dbf35b0d' + ' ' + (x && 'warning')}}">{{w}}/500 (至少30字) </text></view><view class="tags-section data-v-dbf35b0d"><text class="tags-label required data-v-dbf35b0d">理想对象标签 (最多5个)</text><view class="tags-wrap data-v-dbf35b0d"><view xhs:for="{{y}}" xhs:for-item="tag" xhs:key="b" class="{{('tag-item') + ' ' + 'data-v-dbf35b0d' + ' ' + (tag.c && 'active')}}" bindtap="{{tag.d}}">{{tag.a}}</view></view></view></view></view><view xhs:if="{{z}}" class="step-content data-v-dbf35b0d"><view class="step-title data-v-dbf35b0d">上传照片和自我介绍</view><view class="step-desc data-v-dbf35b0d">展示真实的你</view><view class="form-section data-v-dbf35b0d"><view class="avatar-section data-v-dbf35b0d" bindtap="{{B}}"><view class="avatar-wrapper data-v-dbf35b0d"><image class="avatar data-v-dbf35b0d" src="{{A}}" mode="aspectFill"></image><view class="avatar-mask data-v-dbf35b0d"><text class="data-v-dbf35b0d">点击上传</text></view></view><text class="avatar-tip required data-v-dbf35b0d">头像 (必填)</text></view><view class="images-section data-v-dbf35b0d"><text class="images-label data-v-dbf35b0d">个人相册 (可选，最多9张)</text><view class="images-grid data-v-dbf35b0d"><view xhs:for="{{C}}" xhs:for-item="img" xhs:key="d" class="image-item data-v-dbf35b0d"><image class="uploaded-image data-v-dbf35b0d" src="{{img.a}}" mode="aspectFill" bindtap="{{img.b}}"></image><view class="delete-btn data-v-dbf35b0d" catchtap="{{img.c}}">×</view></view><view xhs:if="{{D}}" class="image-item add-btn data-v-dbf35b0d" bindtap="{{E}}"><text class="add-icon data-v-dbf35b0d">+</text><text class="add-text data-v-dbf35b0d">添加</text></view></view></view><view class="textarea-section data-v-dbf35b0d"><text class="textarea-label required data-v-dbf35b0d">自我介绍</text><block xhs:if="{{r0}}"><textarea class="textarea data-v-dbf35b0d" placeholder="介绍一下自己吧，可以聊聊你的性格、兴趣爱好、工作经历等..." maxlength="500" value="{{F}}" bindinput="{{G}}"/></block><text class="{{('char-count') + ' ' + 'data-v-dbf35b0d' + ' ' + (I && 'warning')}}">{{H}}/500 (至少30字) </text></view></view></view><view class="bottom-buttons data-v-dbf35b0d"><button xhs:if="{{J}}" class="btn-secondary data-v-dbf35b0d" bindtap="{{K}}">上一步</button><button xhs:if="{{L}}" class="btn-primary data-v-dbf35b0d" bindtap="{{M}}">下一步</button><button xhs:if="{{N}}" class="btn-primary data-v-dbf35b0d" bindtap="{{O}}" loading="{{P}}">完成</button></view><view xhs:if="{{Q}}" class="picker-overlay data-v-dbf35b0d" bindtap="{{X}}"><view class="picker-popup data-v-dbf35b0d" catchtap="{{W}}"><view class="picker-header data-v-dbf35b0d"><text class="picker-cancel data-v-dbf35b0d" bindtap="{{R}}">取消</text><text class="picker-title data-v-dbf35b0d">选择出生年份</text><text class="picker-confirm data-v-dbf35b0d" bindtap="{{S}}">确定</text></view><picker-view value="{{U}}" bindchange="{{V}}" class="picker-view data-v-dbf35b0d"><picker-view-column class="data-v-dbf35b0d"><view xhs:for="{{T}}" xhs:for-item="year" xhs:key="b" class="picker-item data-v-dbf35b0d">{{year.a}}年</view></picker-view-column></picker-view></view></view><view xhs:if="{{Y}}" class="picker-overlay data-v-dbf35b0d" bindtap="{{af}}"><view class="picker-popup data-v-dbf35b0d" catchtap="{{ae}}"><view class="picker-header data-v-dbf35b0d"><text class="picker-cancel data-v-dbf35b0d" bindtap="{{Z}}">取消</text><text class="picker-title data-v-dbf35b0d">选择身高</text><text class="picker-confirm data-v-dbf35b0d" bindtap="{{aa}}">确定</text></view><picker-view value="{{ac}}" bindchange="{{ad}}" class="picker-view data-v-dbf35b0d"><picker-view-column class="data-v-dbf35b0d"><view xhs:for="{{ab}}" xhs:for-item="h" xhs:key="b" class="picker-item data-v-dbf35b0d">{{h.a}}cm</view></picker-view-column></picker-view></view></view></view>