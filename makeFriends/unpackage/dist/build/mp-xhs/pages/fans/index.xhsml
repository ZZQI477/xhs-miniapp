<view class="container data-v-a7e4d9f1"><view class="tabs data-v-a7e4d9f1"><view class="{{('tab-item') + ' ' + 'data-v-a7e4d9f1' + ' ' + (a && 'active')}}" bindtap="{{b}}"><text class="tab-text data-v-a7e4d9f1">已认证用户</text></view><view class="{{('tab-item') + ' ' + 'data-v-a7e4d9f1' + ' ' + (c && 'active')}}" bindtap="{{d}}"><text class="tab-text data-v-a7e4d9f1">未认证用户</text></view></view><view class="user-list data-v-a7e4d9f1"><view xhs:for="{{e}}" xhs:for-item="user" xhs:key="i" class="user-item data-v-a7e4d9f1" bindtap="{{user.j}}"><image class="user-avatar data-v-a7e4d9f1" src="{{user.a}}" mode="aspectFill"></image><view class="user-info data-v-a7e4d9f1"><view class="user-name data-v-a7e4d9f1"><text class="name data-v-a7e4d9f1">{{user.b}}</text><text xhs:if="{{user.c}}" class="certified-icon data-v-a7e4d9f1">✓</text></view><text class="user-details data-v-a7e4d9f1">{{user.d}}岁 {{user.e}} {{user.f}}cm</text></view><button class="follow-btn data-v-a7e4d9f1" catchtap="{{user.h}}">{{user.g}}</button></view></view><view xhs:if="{{f}}" class="load-more data-v-a7e4d9f1" bindtap="{{h}}"><text class="data-v-a7e4d9f1">{{g}}</text></view><view xhs:if="{{i}}" class="empty data-v-a7e4d9f1"><text class="data-v-a7e4d9f1">暂无粉丝</text></view></view>