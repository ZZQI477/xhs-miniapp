  align-items: center;
  justify-content: center;
  font-size: 30rpx;
  color: #333333;
}

/* 自定义滚动选择器样式 */
.custom-picker-container.data-v-ee97244e {
  position: relative;
  height: 500rpx;
  overflow: hidden;
}
.custom-picker-scroll.data-v-ee97244e {
  height: 100%;
  width: 100%;
}
.custom-picker-content.data-v-ee97244e {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 0;
}
.custom-picker-item.data-v-ee97244e {
  height: 80rpx;
  line-height: 80rpx;
  font-size: 30rpx;
  color: #999999;
  transition: all 0.3s ease;
}
.custom-picker-item.active.data-v-ee97244e {
  color: #333333;
  font-size: 34rpx;
  font-weight: 500;
}
.custom-picker-indicator.data-v-ee97244e {
  position: absolute;
  top: 50%;
