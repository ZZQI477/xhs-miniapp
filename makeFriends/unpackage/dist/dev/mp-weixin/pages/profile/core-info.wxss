/* 弹窗样式 */
.popup-overlay.data-v-ee97244e {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background-color: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: flex-end;
}
.popup-container.data-v-ee97244e {
  width: 100%;
  background-color: #ffffff;
  border-radius: 20rpx 20rpx 0 0;
  animation: slideUp-ee97244e 0.3s ease;
}
@keyframes slideUp-ee97244e {
from {
    transform: translateY(100%);
}
to {
    transform: translateY(0);
}
}
.popup-header.data-v-ee97244e {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}
