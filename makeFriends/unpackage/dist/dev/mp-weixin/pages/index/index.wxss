
.container.data-v-1cf27b2a {
  background-image: url('../../static/bg3.png');
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  height: 100vh;
  position: relative;
  z-index: 0;
  overflow: hidden;
  display: flex;
  flex-direction: column;
  box-sizing: border-box;
}

/* 导航栏占位 */
.nav-bar-placeholder.data-v-1cf27b2a {
  height: 150rpx;
  flex-shrink: 0;
}

/* 首页导航栏标题靠左 */
.data-v-1cf27b2a .custom-nav-bar .nav-title {
  text-align: left;
  padding-left: 20rpx;
}



/* 加载中 */
.loading-container.data-v-1cf27b2a {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 100vh;
}
.loading-icon.data-v-1cf27b2a {
  width: 200rpx;
  height: 200rpx;
  margin-bottom: 30rpx;
  opacity: 0.6;
}
.loading-text.data-v-1cf27b2a {
  font-size: 28rpx;
  color: #999999;
}

/* 卡片滑动区域 */
.card-swiper.data-v-1cf27b2a {
  width: 100%;
  flex-shrink: 0;
  height: calc(100vh - 10vh);
  margin-top: 40rpx;
  overflow: hidden;
}
.card-swiper.data-v-1cf27b2a .uni-swiper-wrapper {
  height: 100%;
}
.card-swiper.data-v-1cf27b2a swiper-item {
  height: 100%;
}
.card-swiper.data-v-1cf27b2a .uni-swiper-item {
  height: 100%;
}
.card-swiper-slide.data-v-1cf27b2a {
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.card-scroll.data-v-1cf27b2a {
  height: calc(100% - 80rpx);
  width: calc(100% - 40rpx);
  box-sizing: border-box;
  margin: 0 20rpx 40rpx;
  background-color: #FFFFFF;
  border-radius: 24rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
  overflow: hidden;
  touch-action: pan-y;
  -webkit-overflow-scrolling: touch;
}
.card-scroll.data-v-1cf27b2a .uni-scroll-view {
  height: 100%;
  overflow-y: auto !important;
  touch-action: pan-y;
  -webkit-overflow-scrolling: touch;
}
.card-scroll.data-v-1cf27b2a .uni-scroll-view-content {
  min-height: 100%;
  touch-action: pan-y;
}

/* 用户卡片 */
.user-card.data-v-1cf27b2a {
  width: 100%;
  min-height: 100%;
  box-sizing: border-box;
}

/* 卡片头部 */
.card-header.data-v-1cf27b2a {
  position: relative;
  height: 550rpx;
  overflow: hidden;
}
.header-bg.data-v-1cf27b2a {
  position: absolute;
  width: 100%;
  height: 100%;
}
.header-overlay.data-v-1cf27b2a {
  position: absolute;
  width: 100%;
  height: 100%;
  background: linear-gradient(180deg, rgba(0,0,0,0.05) 0%, rgba(0,0,0,0.65) 100%);
}
.user-basic.data-v-1cf27b2a {
  position: absolute;
  bottom: 40rpx;
  left: 30rpx;
  text-align: left;
}
.name-row.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  margin-bottom: 16rpx;
}
.nickname.data-v-1cf27b2a {
  font-size: 44rpx;
  font-weight: bold;
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
  max-width: 400rpx;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
  margin-right: 12rpx;
}
.gender-icon.data-v-1cf27b2a {
  width: 40rpx;
  height: 40rpx;
  margin-right: 12rpx;
}
.vip-badge-small.data-v-1cf27b2a {
  width: 48rpx;
  height: 48rpx;
  margin-left: 12rpx;
}
.info-row.data-v-1cf27b2a {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.info-text.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}
.info-separator.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #FFFFFF;
  text-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.4);
}

/* 内容区块 */
.section.data-v-1cf27b2a {
  padding: 30rpx;
  border-bottom: 1rpx solid #F0F0F0;
  background-color: #F4F7FF;
}
.section.data-v-1cf27b2a:last-child {
  border-bottom: none;
}
.section-title.data-v-1cf27b2a {
  font-size: 32rpx;
  font-weight: bold;
  color: #333333;
  margin-bottom: 20rpx;
}

/* 认证区域 */
.cert-section.data-v-1cf27b2a {
  background: #F4F7FF;
}
.section-title.data-v-1cf27b2a {
  font-size: 30rpx;
  font-weight: 600;
  color: #131313;
  margin-bottom: 24rpx;
  display: flex;
  align-items: center;
}
.section-icon.data-v-1cf27b2a {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
}
.section-title.data-v-1cf27b2a::before {
  content: '';
  width: 6rpx;
  height: 28rpx;
  background: linear-gradient(135deg, #FA731D 0%, #FF4D4F 100%);
  border-radius: 3rpx;
  margin-right: 12rpx;
  display: none;
}
.cert-list.data-v-1cf27b2a {
  display: flex;
  gap: 16rpx;
  flex-wrap: wrap;
}
.cert-item.data-v-1cf27b2a {
  flex: 1;
  min-width: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FFFFFF;
  padding: 24rpx 16rpx;
  border-radius: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.04);
}
.cert-icon.data-v-1cf27b2a {
  width: 36rpx;
  height: 36rpx;
  margin-right: 10rpx;
}
.cert-emoji.data-v-1cf27b2a {
  font-size: 36rpx;
  margin-right: 10rpx;
}
.cert-text.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #52C41A;
  font-weight: 500;
}

/* 自我介绍 */
.intro-text.data-v-1cf27b2a {
  font-size: 28rpx;
  color: #666666;
  line-height: 1.8;
}

/* 标签 */
.tags-wrap.data-v-1cf27b2a {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.tag.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #384582;
  background: #DEE4FF;
  padding: 12rpx 28rpx;
  border-radius: 28rpx;
  box-shadow: 0 4rpx 12rpx rgba(222, 228, 255, 0.3);
}
.tag.ideal.data-v-1cf27b2a {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  box-shadow: 0 4rpx 12rpx rgba(102, 126, 234, 0.2);
}

/* 详细信息 */
.detail-grid.data-v-1cf27b2a {
  display: flex;
  flex-wrap: wrap;
}
.detail-item.data-v-1cf27b2a {
  width: 50%;
  display: flex;
  margin-bottom: 16rpx;
}
.detail-label.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #999999;
  width: 100rpx;
}
.detail-value.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #333333;
  flex: 1;
}

/* 照片墙 */
.photo-grid.data-v-1cf27b2a {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
}
.photo-item.data-v-1cf27b2a {
  width: calc(33.33% - 8rpx);
  height: 200rpx;
  border-radius: 12rpx;
}

/* 灵魂问答 */
.soul-list.data-v-1cf27b2a {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.soul-item.data-v-1cf27b2a {
  background-color: #F8F8F8;
  padding: 20rpx;
  border-radius: 12rpx;
}
.soul-q.data-v-1cf27b2a {
  font-size: 28rpx;
  color: #FF4D4F;
  display: block;
  margin-bottom: 12rpx;
}
.soul-a.data-v-1cf27b2a {
  font-size: 26rpx;
  color: #666666;
  line-height: 1.6;
}

/* 卡片底部占位 */
.card-footer.data-v-1cf27b2a {
  height: 100rpx;
}

/* 空状态 */
.empty-container.data-v-1cf27b2a {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex: 1;
  padding: 0 60rpx;
  overflow: hidden;
}
.data-v-1cf27b2a uni-page,.data-v-1cf27b2a uni-page-wrapper,.data-v-1cf27b2a uni-page-body {
  height: 100%;
  overflow: hidden;
}
.empty-icon.data-v-1cf27b2a {
  width: 300rpx;
  height: 300rpx;
  margin-bottom: 40rpx;
  opacity: 0.6;
}
.empty-text.data-v-1cf27b2a {
  font-size: 32rpx;
  color: #999999;
  margin-bottom: 50rpx;
}
.refresh-btn.data-v-1cf27b2a {
  width: 280rpx;
  height: 88rpx;
  line-height: 88rpx;
  background: linear-gradient(135deg, #FA731D 0%, #FF4D4F 100%);
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
  border: none;
  box-shadow: 0 8rpx 20rpx rgba(250, 115, 29, 0.3);
}
.refresh-btn.data-v-1cf27b2a::after {
  border: none;
}

/* 右侧功能栏 */
.side-actions.data-v-1cf27b2a {
  position: fixed;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  gap: 24rpx;
  z-index: 100;
}
.action-item.data-v-1cf27b2a {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
}
.action-icon-wrap.data-v-1cf27b2a {
  width: 96rpx;
  height: 96rpx;
  /* border-radius: 50%; */
  /* background: rgba(255, 255, 255, 0.95); */
  /* backdrop-filter: blur(10rpx); */
  display: flex;
  align-items: center;
  justify-content: center;
  /* box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.12); */
  transition: all 0.3s;
}

