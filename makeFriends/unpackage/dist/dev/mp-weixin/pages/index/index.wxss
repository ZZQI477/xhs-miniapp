/* 客服按钮特殊样式 */
.service-button.data-v-1cf27b2a {
  background: transparent;
  border: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 8rpx;
  line-height: 1;
}
.service-button.data-v-1cf27b2a::after {
  border: none;
}

/* 右上角分享按钮 */
.share-button.data-v-1cf27b2a {
  position: fixed;
  top: 210rpx;
  right: 30rpx;
  z-index: 1000;
}
.share-btn.data-v-1cf27b2a {
  width: auto;
  height: auto;
  min-width: 0;
  min-height: 0;
  border-radius: 0;
  background: transparent;
  -webkit-backdrop-filter: none;
          backdrop-filter: none;
  box-shadow: none;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  border: none;
  margin: 0;
