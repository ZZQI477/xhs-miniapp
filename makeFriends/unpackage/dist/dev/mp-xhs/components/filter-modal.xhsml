<view xhs:if="{{a}}" class="modal-overlay data-v-c4fad269" bindtap="{{j}}"><view class="modal-card data-v-c4fad269" catchtap="{{i}}"><view class="modal-header data-v-c4fad269"><text class="modal-title data-v-c4fad269">筛选条件</text><text class="modal-close data-v-c4fad269" bindtap="{{b}}">✕</text></view><view class="filter-section data-v-c4fad269"><text class="section-label data-v-c4fad269">年龄</text><view class="option-list data-v-c4fad269"><view xhs:for="{{c}}" xhs:for-item="item" xhs:key="c" class="{{('option-item') + ' ' + 'data-v-c4fad269' + ' ' + (item.b && 'active')}}" bindtap="{{item.d}}">{{item.a}}</view></view></view><view class="filter-section data-v-c4fad269"><text class="section-label data-v-c4fad269">身高</text><view class="option-list data-v-c4fad269"><view xhs:for="{{d}}" xhs:for-item="item" xhs:key="c" class="{{('option-item') + ' ' + 'data-v-c4fad269' + ' ' + (item.b && 'active')}}" bindtap="{{item.d}}">{{item.a}}</view></view></view><view class="filter-section data-v-c4fad269"><text class="section-label data-v-c4fad269">学历</text><view class="option-list data-v-c4fad269"><view xhs:for="{{e}}" xhs:for-item="item" xhs:key="c" class="{{('option-item') + ' ' + 'data-v-c4fad269' + ' ' + (item.b && 'active')}}" bindtap="{{item.d}}">{{item.a}}</view></view></view><view class="filter-section data-v-c4fad269"><text class="section-label data-v-c4fad269">城市</text><view class="option-list data-v-c4fad269"><view xhs:for="{{f}}" xhs:for-item="item" xhs:key="c" class="{{('option-item') + ' ' + 'data-v-c4fad269' + ' ' + (item.b && 'active')}}" bindtap="{{item.d}}">{{item.a}}</view></view></view><view class="modal-buttons data-v-c4fad269"><button class="btn-reset data-v-c4fad269" bindtap="{{g}}">重置</button><button class="btn-confirm data-v-c4fad269" bindtap="{{h}}">确定</button></view></view></view>