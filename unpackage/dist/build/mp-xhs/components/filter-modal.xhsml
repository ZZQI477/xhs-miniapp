<view xhs:if="{{a}}" class="modal-overlay data-v-519dce8e" bindtap="{{j}}"><view class="modal-card data-v-519dce8e" catchtap="{{i}}"><view class="modal-header data-v-519dce8e"><text class="modal-title data-v-519dce8e">筛选条件</text><text class="modal-close data-v-519dce8e" bindtap="{{b}}">✕</text></view><view class="filter-section data-v-519dce8e"><text class="section-label data-v-519dce8e">年龄</text><view class="option-list data-v-519dce8e"><view xhs:for="{{c}}" xhs:for-item="item" xhs:key="c" class="{{('option-item') + ' ' + 'data-v-519dce8e' + ' ' + (item.b && 'active')}}" bindtap="{{item.d}}">{{item.a}}</view></view></view><view class="filter-section data-v-519dce8e"><text class="section-label data-v-519dce8e">身高</text><view class="option-list data-v-519dce8e"><view xhs:for="{{d}}" xhs:for-item="item" xhs:key="c" class="{{('option-item') + ' ' + 'data-v-519dce8e' + ' ' + (item.b && 'active')}}" bindtap="{{item.d}}">{{item.a}}</view></view></view><view class="filter-section data-v-519dce8e"><text class="section-label data-v-519dce8e">学历</text><view class="option-list data-v-519dce8e"><view xhs:for="{{e}}" xhs:for-item="item" xhs:key="c" class="{{('option-item') + ' ' + 'data-v-519dce8e' + ' ' + (item.b && 'active')}}" bindtap="{{item.d}}">{{item.a}}</view></view></view><view class="filter-section data-v-519dce8e"><text class="section-label data-v-519dce8e">城市</text><view class="option-list data-v-519dce8e"><view xhs:for="{{f}}" xhs:for-item="item" xhs:key="c" class="{{('option-item') + ' ' + 'data-v-519dce8e' + ' ' + (item.b && 'active')}}" bindtap="{{item.d}}">{{item.a}}</view></view></view><view class="modal-buttons data-v-519dce8e"><button class="btn-reset data-v-519dce8e" bindtap="{{g}}">重置</button><button class="btn-confirm data-v-519dce8e" bindtap="{{h}}">确定</button></view></view></view>