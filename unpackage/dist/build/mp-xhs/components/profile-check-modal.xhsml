<view xhs:if="{{a}}" class="modal-overlay data-v-263ac0ab" bindtap="{{g}}"><view class="modal-card data-v-263ac0ab" catchtap="{{f}}"><view class="modal-icon data-v-263ac0ab"><text class="icon-emoji data-v-263ac0ab">📝</text></view><view class="modal-title data-v-263ac0ab">完善您的资料</view><view class="progress-section data-v-263ac0ab"><view class="progress-bar data-v-263ac0ab"><view class="progress-fill data-v-263ac0ab" style="{{'width:' + b}}"></view></view><text class="progress-text data-v-263ac0ab">当前完善度 {{c}}%</text></view><view class="modal-desc data-v-263ac0ab"> 完善资料获得更多曝光和匹配推荐，让更多人看到你！ </view><view class="modal-buttons data-v-263ac0ab"><button class="btn-primary data-v-263ac0ab" bindtap="{{d}}">立即完善</button><button class="btn-secondary data-v-263ac0ab" bindtap="{{e}}">稍后再说</button></view></view></view>