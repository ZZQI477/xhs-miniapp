<view class="container data-v-dce57ad2"><view class="coin-balance data-v-dce57ad2" bindtap="{{b}}"><view class="balance-info data-v-dce57ad2"><text class="balance-label data-v-dce57ad2">脱单币余额</text><view class="balance-amount data-v-dce57ad2"><text class="amount-number data-v-dce57ad2">{{a}}</text><text class="amount-dot data-v-dce57ad2">•</text></view></view><view class="get-more-btn data-v-dce57ad2">获取更多</view></view><view class="rocket-icon data-v-dce57ad2"><text class="rocket data-v-dce57ad2">🚀</text></view><view xhs:if="{{c}}" class="recharge-modal data-v-dce57ad2"><view class="modal-backdrop data-v-dce57ad2" bindtap="{{d}}"></view><view class="recharge-content data-v-dce57ad2"><view class="recharge-title data-v-dce57ad2">脱单币充值</view><view class="recharge-options data-v-dce57ad2"><view xhs:for="{{e}}" xhs:for-item="pkg" xhs:key="e" class="{{('option-item') + ' ' + 'data-v-dce57ad2' + ' ' + (pkg.d && 'active')}}" bindtap="{{pkg.f}}"><view xhs:if="{{pkg.a}}" class="recommended-tag data-v-dce57ad2">推荐</view><view class="option-content data-v-dce57ad2"><text class="option-coin data-v-dce57ad2">{{pkg.b}}脱单币</text><text class="option-price data-v-dce57ad2">{{pkg.c}}元</text></view></view></view><button class="confirm-btn data-v-dce57ad2" disabled="{{f}}" bindtap="{{g}}">确定</button><view class="agreement data-v-dce57ad2"><input type="checkbox" class="agreement-checkbox data-v-dce57ad2" value="{{h}}" bindinput="{{i}}"></input><text class="agreement-text data-v-dce57ad2">同意</text><text class="agreement-link data-v-dce57ad2">《在线充值服务协议》</text></view></view></view></view>