<view class="container data-v-c5717e88"><view class="header data-v-c5717e88"><text class="title data-v-c5717e88">重置密码</text><text class="subtitle data-v-c5717e88">请输入注册时的手机号重置密码</text></view><view class="form-section data-v-c5717e88"><view class="input-group data-v-c5717e88"><text class="input-label data-v-c5717e88">手机号</text><view class="input-wrapper data-v-c5717e88"><text class="country-code data-v-c5717e88">+86</text><input class="input-field data-v-c5717e88" type="number" placeholder="请输入手机号" maxlength="11" value="{{a}}" bindinput="{{b}}"/></view></view><view class="input-group data-v-c5717e88"><text class="input-label data-v-c5717e88">验证码</text><view class="input-wrapper code-wrapper data-v-c5717e88"><input class="input-field data-v-c5717e88" type="number" placeholder="请输入验证码" maxlength="6" value="{{c}}" bindinput="{{d}}"/><button class="code-btn data-v-c5717e88" disabled="{{f}}" bindtap="{{g}}">{{e}}</button></view></view><view class="input-group data-v-c5717e88"><text class="input-label data-v-c5717e88">新密码</text><view class="input-wrapper data-v-c5717e88"><block xhs:if="{{r0}}"><input class="input-field data-v-c5717e88" type="{{h}}" placeholder="请输入新密码(6-20位)" maxlength="20" value="{{i}}" bindinput="{{j}}"/></block><text class="eye-icon data-v-c5717e88" bindtap="{{l}}">{{k}}</text></view></view><view class="input-group data-v-c5717e88"><text class="input-label data-v-c5717e88">确认密码</text><view class="input-wrapper data-v-c5717e88"><block xhs:if="{{r0}}"><input class="input-field data-v-c5717e88" type="{{m}}" placeholder="请再次输入新密码" maxlength="20" value="{{n}}" bindinput="{{o}}"/></block><text class="eye-icon data-v-c5717e88" bindtap="{{q}}">{{p}}</text></view></view><button class="submit-btn data-v-c5717e88" loading="{{r}}" bindtap="{{s}}"> 重置密码 </button><view class="back-login data-v-c5717e88"><text class="data-v-c5717e88" bindtap="{{t}}">返回登录</text></view></view></view>