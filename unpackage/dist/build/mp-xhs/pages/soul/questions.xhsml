<view class="container data-v-7bf08b5f"><view class="description data-v-7bf08b5f"><text class="data-v-7bf08b5f">请认真随机选取三个问题进行回答，你的答案将会展示在你的个人主页上，同时也会增加你的匹配精准度。</text></view><view xhs:for="{{a}}" xhs:for-item="item" xhs:key="f" class="question-section data-v-7bf08b5f"><view class="question-title data-v-7bf08b5f"><text class="question-number data-v-7bf08b5f">? 灵魂{{item.a}}问</text></view><view class="question-select data-v-7bf08b5f" bindtap="{{item.c}}"><text class="question-text data-v-7bf08b5f">{{item.b}}</text><text class="select-arrow data-v-7bf08b5f">▼</text></view><view class="answer-title data-v-7bf08b5f">我的回答</view><block xhs:if="{{r0}}"><textarea class="answer-input data-v-7bf08b5f" placeholder="请输入你的回答" placeholder-style="color: #999999;" value="{{item.d}}" bindinput="{{item.e}}"></textarea></block></view><button class="save-btn data-v-7bf08b5f" bindtap="{{b}}">保存</button><view xhs:if="{{c}}" class="picker-modal data-v-7bf08b5f"><view class="picker-backdrop data-v-7bf08b5f" bindtap="{{d}}"></view><view class="picker-content data-v-7bf08b5f"><view class="picker-header data-v-7bf08b5f"><text class="picker-cancel data-v-7bf08b5f" bindtap="{{e}}">取消</text><text class="picker-title data-v-7bf08b5f">选择问题</text><text class="picker-confirm data-v-7bf08b5f" bindtap="{{f}}">确定</text></view><picker-view class="picker-view data-v-7bf08b5f" value="{{h}}" bindchange="{{i}}"><picker-view-column class="data-v-7bf08b5f"><view xhs:for="{{g}}" xhs:for-item="q" xhs:key="b" class="picker-item data-v-7bf08b5f">{{q.a}}</view></picker-view-column></picker-view></view></view></view>