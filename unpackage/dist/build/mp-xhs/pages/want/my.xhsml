<view class="container data-v-60d94bc2"><view xhs:if="{{a}}" class="empty data-v-60d94bc2"><text class="empty-icon data-v-60d94bc2">👀</text><text class="empty-text data-v-60d94bc2">暂无记录</text><text class="empty-tip data-v-60d94bc2">去单身库看看感兴趣的人吧</text><navigator class="empty-btn data-v-60d94bc2" url="/pages/single/index">去看看</navigator></view><view xhs:else class="list data-v-60d94bc2"><view xhs:for="{{b}}" xhs:for-item="item" xhs:key="k" class="list-item data-v-60d94bc2" bindtap="{{item.l}}"><image class="avatar data-v-60d94bc2" src="{{item.a}}" mode="aspectFill"></image><view class="info data-v-60d94bc2"><view class="info-top data-v-60d94bc2"><text class="nickname data-v-60d94bc2">{{item.b}}</text><text class="{{('gender') + ' ' + 'data-v-60d94bc2' + ' ' + (item.d && 'female')}}">{{item.c}}</text></view><text class="desc data-v-60d94bc2">{{item.e}}岁 · {{item.f}}cm · {{item.g}}</text><text class="time data-v-60d94bc2">{{item.h}}</text></view><view class="{{('want-type') + ' ' + 'data-v-60d94bc2' + ' ' + item.j}}">{{item.i}}</view></view></view><view xhs:if="{{c}}" class="load-more data-v-60d94bc2"><text xhs:if="{{d}}" class="data-v-60d94bc2">加载中...</text><text xhs:elif="{{e}}" class="data-v-60d94bc2">没有更多了</text><text xhs:else class="data-v-60d94bc2" bindtap="{{f}}">点击加载更多</text></view></view>