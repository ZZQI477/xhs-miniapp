<view class="container data-v-520021ee"><profile-check-modal xhs:if="{{b}}" class="data-v-520021ee" bindconfirm="__e" binddismiss="__e" u-i="520021ee-0" bind:__l="__l" eO="{{a}}" u-p="{{b}}"/><filter-modal xhs:if="{{d}}" class="data-v-520021ee" bindconfirm="__e" binddismiss="__e" u-i="520021ee-1" bind:__l="__l" eO="{{c}}" u-p="{{d}}"/><qrcode-modal xhs:if="{{f}}" class="data-v-520021ee" bindclose="__e" u-i="520021ee-2" bind:__l="__l" eO="{{e}}" u-p="{{f}}"/><swiper xhs:if="{{g}}" class="banner data-v-520021ee" indicator-dots circular><swiper-item xhs:for="{{h}}" xhs:for-item="banner" xhs:key="c" class="data-v-520021ee"><view class="banner-item data-v-520021ee"><image class="data-v-520021ee" src="{{banner.a}}" mode="aspectFill"></image><view class="banner-content data-v-520021ee"><text class="banner-title data-v-520021ee">同城单身交友群</text><text class="banner-subtitle data-v-520021ee">已有 5000+ 人加入</text><button class="join-btn data-v-520021ee" bindtap="{{banner.b}}">立即加群 →</button></view></view></swiper-item></swiper><view class="filter-tabs data-v-520021ee"><view class="{{('tab-item') + ' ' + 'data-v-520021ee' + ' ' + (i && 'active')}}" bindtap="{{j}}">女嘉宾</view><view class="{{('tab-item') + ' ' + 'data-v-520021ee' + ' ' + (k && 'active')}}" bindtap="{{l}}">男嘉宾</view><view class="{{('tab-item') + ' ' + 'data-v-520021ee' + ' ' + (m && 'active')}}" bindtap="{{n}}">已脱单</view><button xhs:if="{{o}}" class="filter-btn data-v-520021ee" type="default" bindtap="{{p}}"><text class="filter-icon data-v-520021ee">⚙️</text><text class="data-v-520021ee">筛选</text></button></view><view xhs:if="{{q}}" class="user-list data-v-520021ee"><view xhs:for="{{r}}" xhs:for-item="user" xhs:key="e" class="user-card data-v-520021ee" bindtap="{{user.f}}"><view class="avatar-container data-v-520021ee"><image class="avatar data-v-520021ee" src="{{user.a}}" mode="aspectFill"></image></view><view class="user-info data-v-520021ee"><text class="age-city data-v-520021ee">{{user.b}}岁 {{user.c}}</text><view class="tags data-v-520021ee"><text xhs:for="{{user.d}}" xhs:for-item="tag" xhs:key="c" class="{{('tag') + ' ' + 'data-v-520021ee' + ' ' + tag.b}}">{{tag.a}}</text></view></view></view></view><view xhs:if="{{s}}" class="couple-list data-v-520021ee"><view xhs:for="{{t}}" xhs:for-item="item" xhs:key="f" class="couple-card data-v-520021ee"><view class="couple-avatar data-v-520021ee"><image class="avatar-blur data-v-520021ee" src="{{item.a}}" mode="aspectFill"></image></view><view class="couple-info data-v-520021ee"><text class="couple-name data-v-520021ee">{{item.b}}</text><view class="couple-detail data-v-520021ee"><text class="data-v-520021ee">注册时间: {{item.c}}</text></view><view class="couple-detail data-v-520021ee"><text class="data-v-520021ee">脱单时间: {{item.d}}</text></view><view class="couple-detail data-v-520021ee"><text class="data-v-520021ee">脱单方式: {{item.e}}</text></view></view></view></view><view xhs:if="{{v}}" class="load-more data-v-520021ee" bindtap="{{x}}"><text class="data-v-520021ee">{{w}}</text></view><view xhs:if="{{y}}" class="empty data-v-520021ee"><text class="data-v-520021ee">暂无数据</text></view></view>