<view class="chat-detail-container data-v-ee06274a"><custom-nav-bar xhs:if="{{a}}" class="data-v-ee06274a" u-i="ee06274a-0" bind:__l="__l" u-p="{{a}}"></custom-nav-bar><view class="nav-bar-placeholder data-v-ee06274a"></view><view xhs:if="{{b}}" class="guest-tip data-v-ee06274a"><text class="tip-text data-v-ee06274a">您正在以游客身份聊天</text><text class="login-btn data-v-ee06274a" bindtap="{{c}}">去登录</text></view><scroll-view class="message-list data-v-ee06274a" scroll-y enhanced show-scrollbar="{{false}}" scroll-into-view="{{h}}" scroll-with-animation="{{true}}"><view xhs:if="{{d}}" class="load-history data-v-ee06274a" bindtap="{{f}}"><text xhs:if="{{e}}" class="data-v-ee06274a">加载中...</text><text xhs:else class="data-v-ee06274a">点击加载更多历史消息</text></view><view xhs:for="{{g}}" xhs:for-item="msg" xhs:key="d" class="message-item data-v-ee06274a" id="{{msg.e}}"><chat-message xhs:if="{{msg.c}}" class="data-v-ee06274a" bindavatarTap="__e" u-i="{{msg.a}}" bind:__l="__l" eO="{{msg.b}}" u-p="{{msg.c}}"/></view><view class="list-bottom-space data-v-ee06274a" id="msg_bottom"></view></scroll-view><chat-input xhs:if="{{k}}" class="r data-v-ee06274a" u-r="chatInput" bindsend="__e" bindsendImage="__e" u-i="ee06274a-2" bind:__l="__l" eO="{{j}}" u-p="{{k}}"/><view xhs:if="{{l}}" class="user-modal-mask data-v-ee06274a" bindtap="{{m}}"></view><view xhs:if="{{n}}" class="user-modal data-v-ee06274a"><view class="modal-header data-v-ee06274a"><image class="modal-avatar data-v-ee06274a" src="{{o}}" mode="aspectFill"></image><view class="modal-info data-v-ee06274a"><text class="modal-nickname data-v-ee06274a">{{p}}</text><text class="modal-desc data-v-ee06274a">{{q}}岁 · {{r}}</text></view></view><view class="modal-actions data-v-ee06274a"><view class="modal-btn data-v-ee06274a" bindtap="{{s}}"><text class="modal-btn-text data-v-ee06274a">查看资料</text></view><view xhs:if="{{t}}" class="modal-btn primary data-v-ee06274a" bindtap="{{v}}"><text class="modal-btn-text data-v-ee06274a">添加好友</text></view></view><view class="modal-close data-v-ee06274a" bindtap="{{w}}"><text class="close-text data-v-ee06274a">×</text></view></view></view>