<view class="chat-list-container data-v-32c40775"><custom-nav-bar xhs:if="{{a}}" class="data-v-32c40775" u-i="32c40775-0" bind:__l="__l" u-p="{{a}}"/><view class="nav-bar-placeholder data-v-32c40775"></view><view xhs:if="{{b}}" class="guest-tip data-v-32c40775"><text class="tip-text data-v-32c40775">您正在以游客身份聊天，去登录</text><text class="login-btn data-v-32c40775" bindtap="{{c}}">立即登录</text></view><view xhs:if="{{d}}" class="loading-container data-v-32c40775"><text class="loading-text data-v-32c40775">加载中...</text></view><view xhs:if="{{e}}" class="empty-container data-v-32c40775"><image class="empty-icon data-v-32c40775" src="{{f}}" mode="aspectFit"></image><text class="empty-text data-v-32c40775">暂无聊天记录</text></view><scroll-view xhs:if="{{g}}" class="conversation-list data-v-32c40775" scroll-y enhanced show-scrollbar="{{false}}"><view xhs:for="{{h}}" xhs:for-item="item" xhs:key="h" class="conversation-item data-v-32c40775" bindtap="{{item.i}}" bindlongpress="{{item.j}}"><view class="avatar-wrapper data-v-32c40775"><image class="avatar data-v-32c40775" src="{{item.a}}" mode="aspectFill"></image><view xhs:if="{{item.b}}" class="online-badge data-v-32c40775"></view></view><view class="conversation-info data-v-32c40775"><view class="info-header data-v-32c40775"><text class="nickname data-v-32c40775">{{item.c}}</text><text class="time-text data-v-32c40775">{{item.d}}</text></view><view class="info-content data-v-32c40775"><text class="last-message data-v-32c40775">{{item.e}}</text><view xhs:if="{{item.f}}" class="unread-badge data-v-32c40775"><text class="unread-count data-v-32c40775">{{item.g}}</text></view></view></view></view><view xhs:if="{{i}}" class="load-more data-v-32c40775"><text xhs:if="{{j}}" class="data-v-32c40775">加载中...</text><text xhs:else class="data-v-32c40775" bindtap="{{k}}">加载更多</text></view></scroll-view><view xhs:if="{{l}}" class="action-sheet-mask data-v-32c40775" bindtap="{{m}}"></view><view xhs:if="{{n}}" class="action-sheet data-v-32c40775"><view class="action-item data-v-32c40775" bindtap="{{o}}"><text class="action-text data-v-32c40775">标记为已读</text></view><view class="action-item danger data-v-32c40775" bindtap="{{p}}"><text class="action-text data-v-32c40775">屏蔽用户</text></view><view class="action-item cancel data-v-32c40775" bindtap="{{q}}"><text class="action-text data-v-32c40775">取消</text></view></view></view>