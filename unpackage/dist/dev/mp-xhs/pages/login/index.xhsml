<view class="login-container data-v-d08ef7d4"><view xhs:if="{{a}}" class="checking-login data-v-d08ef7d4"><view class="loading-spinner data-v-d08ef7d4"></view><text class="loading-text data-v-d08ef7d4">正在登录...</text></view><view xhs:else class="data-v-d08ef7d4"><view class="title-section data-v-d08ef7d4"><image class="title-image data-v-d08ef7d4" src="{{b}}" mode="aspectFit"></image></view><view class="input-wrapper data-v-d08ef7d4"><image class="input-icon data-v-d08ef7d4" src="{{c}}" mode="aspectFit"></image><input class="phone-input data-v-d08ef7d4" type="number" maxlength="{{d}}" placeholder="输入手机号" value="{{e}}" bindinput="{{f}}"/></view><view class="input-wrapper code-input-wrapper data-v-d08ef7d4"><image class="input-icon data-v-d08ef7d4" src="{{g}}" mode="aspectFit"></image><input class="code-input data-v-d08ef7d4" type="number" maxlength="4" placeholder="输入验证码" bindinput="{{h}}" value="{{i}}"/><text class="{{('code-btn') + ' ' + 'data-v-d08ef7d4' + ' ' + (k && 'disabled')}}" bindtap="{{l}}">{{j}}</text></view><view xhs:if="{{m}}" class="{{('agreement-tip-wrapper') + ' ' + 'data-v-d08ef7d4' + ' ' + (n && 'shaking')}}"><view class="agreement-bubble data-v-d08ef7d4"><text class="data-v-d08ef7d4">请先阅读并同意协议</text></view></view><button class="{{('login-btn') + ' ' + 'data-v-d08ef7d4' + ' ' + (o && 'disabled')}}" loading="{{p}}" bindtap="{{q}}"> 登录 </button><view class="agreement-section data-v-d08ef7d4"><view class="checkbox-wrapper data-v-d08ef7d4" bindtap="{{t}}"><view class="{{('checkbox') + ' ' + 'data-v-d08ef7d4' + ' ' + (s && 'checked')}}"><text xhs:if="{{r}}" class="check-mark data-v-d08ef7d4">✓</text></view></view><view class="agreement-text data-v-d08ef7d4"><text class="data-v-d08ef7d4">我已经阅读并同意</text><text class="link data-v-d08ef7d4" catchtap="{{v}}">《用户协议》</text><text class="data-v-d08ef7d4">与</text><text class="link data-v-d08ef7d4" catchtap="{{w}}">《隐私协议》</text></view></view><view class="xiaohongshu-login-section data-v-d08ef7d4" style="display:none"><view class="divider data-v-d08ef7d4"><view class="divider-line data-v-d08ef7d4"></view><text class="divider-text data-v-d08ef7d4">快捷登录</text><view class="divider-line data-v-d08ef7d4"></view></view><view class="xiaohongshu-btn data-v-d08ef7d4" bindtap="{{y}}"><image class="xiaohongshu-icon data-v-d08ef7d4" src="{{x}}" mode="aspectFit"></image></view></view></view></view>