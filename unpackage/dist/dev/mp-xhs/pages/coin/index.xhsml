<view class="container data-v-aab969b6"><view class="coin-balance data-v-aab969b6" bindtap="{{b}}"><view class="coin-icon-container data-v-aab969b6"><image class="coin-icon data-v-aab969b6" src="https://minixhs.chugao520.com/makefriends/位图.png" mode="aspectFit"></image></view><view class="balance-info data-v-aab969b6"><text class="balance-label data-v-aab969b6">我的脱单币</text><text class="balance-amount data-v-aab969b6">{{a}}</text></view><view class="get-more-btn data-v-aab969b6">获取更多 <image class="more-icon data-v-aab969b6" src="https://minixhs.chugao520.com/makefriends/round_right_fill.png" mode="aspectFit"></image></view></view><view class="rocket-icon data-v-aab969b6"><text class="rocket data-v-aab969b6">🚀</text></view><view xhs:if="{{c}}" class="recharge-modal data-v-aab969b6"><view class="modal-backdrop data-v-aab969b6" bindtap="{{d}}"></view><view class="recharge-content data-v-aab969b6"><view class="recharge-title data-v-aab969b6">脱单币充值</view><view class="recharge-options data-v-aab969b6"><view xhs:for="{{e}}" xhs:for-item="pkg" xhs:key="e" class="{{('option-item') + ' ' + 'data-v-aab969b6' + ' ' + (pkg.d && 'active')}}" bindtap="{{pkg.f}}"><view xhs:if="{{pkg.a}}" class="recommended-tag data-v-aab969b6">推荐</view><view class="option-content data-v-aab969b6"><text class="option-coin data-v-aab969b6">{{pkg.b}}脱单币</text><text class="option-price data-v-aab969b6">{{pkg.c}}元</text></view></view></view><button class="confirm-btn data-v-aab969b6" disabled="{{f}}" bindtap="{{g}}">确定</button><view class="agreement data-v-aab969b6"><checkbox-group class="data-v-aab969b6" bindchange="{{i}}"><checkbox checked="{{h}}" color="#FF4D4F" class="agreement-checkbox data-v-aab969b6"/></checkbox-group><text class="agreement-text data-v-aab969b6" bindtap="{{j}}">同意</text><text class="agreement-link data-v-aab969b6">《在线充值服务协议》</text></view></view></view></view>