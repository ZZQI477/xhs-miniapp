<view class="container data-v-54cbdccf"><view class="tabs data-v-54cbdccf"><view class="{{('tab-item') + ' ' + 'data-v-54cbdccf' + ' ' + (a && 'active')}}" bindtap="{{b}}"><text class="tab-text data-v-54cbdccf">已认证用户</text></view><view class="{{('tab-item') + ' ' + 'data-v-54cbdccf' + ' ' + (c && 'active')}}" bindtap="{{d}}"><text class="tab-text data-v-54cbdccf">未认证用户</text></view></view><view class="user-list data-v-54cbdccf"><view xhs:for="{{e}}" xhs:for-item="user" xhs:key="i" class="user-item data-v-54cbdccf" bindtap="{{user.j}}"><image class="user-avatar data-v-54cbdccf" src="{{user.a}}" mode="aspectFill"></image><view class="user-info data-v-54cbdccf"><view class="user-name data-v-54cbdccf"><text class="name data-v-54cbdccf">{{user.b}}</text><text xhs:if="{{user.c}}" class="certified-icon data-v-54cbdccf">✓</text></view><text class="user-details data-v-54cbdccf">{{user.d}}岁 {{user.e}} {{user.f}}cm</text></view><button class="follow-btn data-v-54cbdccf" catchtap="{{user.h}}">{{user.g}}</button></view></view><view xhs:if="{{f}}" class="load-more data-v-54cbdccf" bindtap="{{h}}"><text class="data-v-54cbdccf">{{g}}</text></view><view xhs:if="{{i}}" class="empty data-v-54cbdccf"><text class="data-v-54cbdccf">暂无粉丝</text></view></view>