<view tt:if="{{a}}" class="modal-overlay data-v-73c140bc" bindtap="{{j}}"><view class="modal-card data-v-73c140bc" catchtap="{{i}}"><view class="modal-icon data-v-73c140bc"><text class="icon-emoji data-v-73c140bc">📝</text></view><view class="modal-title data-v-73c140bc">完善您的资料</view><view class="progress-section data-v-73c140bc"><view class="progress-bar data-v-73c140bc"><view class="progress-fill data-v-73c140bc" style="{{'width:' + b}}"></view></view><text class="progress-text data-v-73c140bc">当前完善度 {{c}}%</text></view><view class="modal-desc data-v-73c140bc">{{d}}</view><view tt:if="{{e}}" class="missing-list data-v-73c140bc"><text class="missing-title data-v-73c140bc">建议优先完善：</text><text class="missing-text data-v-73c140bc">{{f}}</text></view><view class="modal-buttons data-v-73c140bc"><button class="btn-primary data-v-73c140bc" bindtap="{{g}}">立即完善</button><button class="btn-secondary data-v-73c140bc" bindtap="{{h}}">稍后再说</button></view></view></view>