<view class="container data-v-de60bf8e"><custom-nav-bar tt:if="{{a}}" class="data-v-de60bf8e" u-i="de60bf8e-0" bind:__l="__l" u-p="{{a}}"/><view class="nav-bar-placeholder data-v-de60bf8e"></view><view class="top-banner data-v-de60bf8e"><view class="banner-text data-v-de60bf8e"><text class="banner-title data-v-de60bf8e">请认真回答！</text><text class="banner-subtitle data-v-de60bf8e">你的答案将会展示在个人主页上，同时也会增加你的匹配精准度。</text></view><image class="banner-image data-v-de60bf8e" src="{{b}}" mode="aspectFit"></image></view><view tt:for="{{c}}" tt:for-item="item" tt:key="f" class="question-section data-v-de60bf8e"><view class="question-title data-v-de60bf8e"><image class="question-icon data-v-de60bf8e" src="{{d}}" mode="aspectFit"></image><text class="question-number data-v-de60bf8e">灵魂{{item.a}}问</text></view><view class="question-select data-v-de60bf8e" bindtap="{{item.c}}"><text class="question-text data-v-de60bf8e">{{item.b}}</text><text class="select-arrow data-v-de60bf8e">▼</text></view><view class="answer-title data-v-de60bf8e"><image class="answer-icon data-v-de60bf8e" src="{{e}}" mode="aspectFit"></image><text class="data-v-de60bf8e">我的回答</text></view><textarea class="answer-input data-v-de60bf8e" placeholder="请输入你的回答" placeholder-style="color: #999999;" value="{{item.d}}" bindinput="{{item.e}}"></textarea></view><button class="save-btn data-v-de60bf8e" bindtap="{{f}}">确定提交</button><view tt:if="{{g}}" class="picker-modal data-v-de60bf8e"><view class="picker-backdrop data-v-de60bf8e" bindtap="{{h}}"></view><view class="picker-content data-v-de60bf8e"><view class="picker-header data-v-de60bf8e"><text class="picker-cancel data-v-de60bf8e" bindtap="{{i}}">取消</text><text class="picker-title data-v-de60bf8e">选择问题</text><text class="picker-confirm data-v-de60bf8e" bindtap="{{j}}">确定</text></view><picker-view class="picker-view data-v-de60bf8e" value="{{l}}" bindchange="{{m}}"><picker-view-column class="data-v-de60bf8e"><view tt:for="{{k}}" tt:for-item="q" tt:key="b" class="picker-item data-v-de60bf8e">{{q.a}}</view></picker-view-column></picker-view></view></view></view>