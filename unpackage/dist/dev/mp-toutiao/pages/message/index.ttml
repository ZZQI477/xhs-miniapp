<view class="container data-v-780fc0ad"><view class="tabs data-v-780fc0ad"><view tt:for="{{a}}" tt:for-item="tab" tt:key="d" class="{{('tab-item') + ' ' + 'data-v-780fc0ad' + ' ' + (tab.e && 'active')}}" bindtap="{{tab.f}}">{{tab.a}} <view tt:if="{{tab.b}}" class="badge data-v-780fc0ad">{{tab.c}}</view></view></view><view tt:if="{{b}}" class="action-bar data-v-780fc0ad"><text class="action-btn data-v-780fc0ad" bindtap="{{c}}">全部已读</text><text class="action-btn danger data-v-780fc0ad" bindtap="{{d}}">清空</text></view><view tt:if="{{e}}" class="empty data-v-780fc0ad"><text class="empty-icon data-v-780fc0ad">📭</text><text class="empty-text data-v-780fc0ad">暂无消息</text></view><view tt:else class="list data-v-780fc0ad"><view tt:for="{{f}}" tt:for-item="item" tt:key="q" class="{{('message-item') + ' ' + 'data-v-780fc0ad' + ' ' + (item.r && 'unread')}}" bindtap="{{item.s}}"><view class="{{('message-icon') + ' ' + 'data-v-780fc0ad' + ' ' + item.c}}"><text tt:if="{{item.a}}" class="data-v-780fc0ad">💌</text><text tt:elif="{{item.b}}" class="data-v-780fc0ad">👀</text><text tt:else class="data-v-780fc0ad">📢</text></view><view class="message-content data-v-780fc0ad"><view class="message-header data-v-780fc0ad"><text class="message-title data-v-780fc0ad">{{item.d}}</text><text class="message-time data-v-780fc0ad">{{item.e}}</text></view><text class="message-desc data-v-780fc0ad">{{item.f}}</text><view tt:if="{{item.g}}" class="want-info data-v-780fc0ad"><view class="want-label data-v-780fc0ad"><text class="want-icon data-v-780fc0ad">👀</text><text class="want-type-text data-v-780fc0ad">对方想看你的{{item.h}}</text></view></view><view tt:if="{{item.i}}" class="wechat-info data-v-780fc0ad"><view class="wechat-label data-v-780fc0ad"><text class="wechat-icon data-v-780fc0ad">💬</text><text class="wechat-text data-v-780fc0ad">对方微信号</text></view><view class="wechat-value data-v-780fc0ad"><text class="wechat-number data-v-780fc0ad">{{item.j}}</text><text class="copy-btn data-v-780fc0ad" catchtap="{{item.k}}">复制</text></view></view><view tt:if="{{item.l}}" class="from-user data-v-780fc0ad" catchtap="{{item.o}}"><image class="from-avatar data-v-780fc0ad" src="{{item.m}}" mode="aspectFill"></image><text class="from-name data-v-780fc0ad">{{item.n}}</text><text class="view-btn data-v-780fc0ad">查看 →</text></view></view><view tt:if="{{item.p}}" class="unread-dot data-v-780fc0ad"></view></view></view><view tt:if="{{g}}" class="load-more data-v-780fc0ad"><text tt:if="{{h}}" class="data-v-780fc0ad">加载中...</text><text tt:elif="{{i}}" class="data-v-780fc0ad">没有更多了</text><text tt:else class="data-v-780fc0ad" bindtap="{{j}}">点击加载更多</text></view></view>