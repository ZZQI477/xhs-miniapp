<view class="container data-v-f956566a"><view class="tabs data-v-f956566a"><view class="{{('tab-item') + ' ' + 'data-v-f956566a' + ' ' + (a && 'active')}}" bindtap="{{b}}"><text class="tab-text data-v-f956566a">已认证用户</text></view><view class="{{('tab-item') + ' ' + 'data-v-f956566a' + ' ' + (c && 'active')}}" bindtap="{{d}}"><text class="tab-text data-v-f956566a">未认证用户</text></view></view><view class="user-list data-v-f956566a"><view tt:for="{{e}}" tt:for-item="user" tt:key="h" class="user-item data-v-f956566a" bindtap="{{user.i}}"><image class="user-avatar data-v-f956566a" src="{{user.a}}" mode="aspectFill"></image><view class="user-info data-v-f956566a"><view class="user-name data-v-f956566a"><text class="name data-v-f956566a">{{user.b}}</text><text tt:if="{{user.c}}" class="certified-icon data-v-f956566a">✓</text></view><text class="user-details data-v-f956566a">{{user.d}}岁 {{user.e}} {{user.f}}cm</text></view><button class="cancel-follow-btn data-v-f956566a" catchtap="{{user.g}}">取消关注</button></view></view><view tt:if="{{f}}" class="load-more data-v-f956566a" bindtap="{{h}}"><text class="data-v-f956566a">{{g}}</text></view><view tt:if="{{i}}" class="empty data-v-f956566a"><text class="data-v-f956566a">暂无关注</text></view></view>