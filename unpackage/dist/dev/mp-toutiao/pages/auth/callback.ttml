<view class="container data-v-aad8bf2b"><view class="{{('result-icon') + ' ' + 'data-v-aad8bf2b' + ' ' + d}}"><text tt:if="{{a}}" class="data-v-aad8bf2b">...</text><text tt:if="{{b}}" class="data-v-aad8bf2b">✓</text><text tt:if="{{c}}" class="data-v-aad8bf2b">✕</text></view><text class="result-title data-v-aad8bf2b">{{e}}</text><text class="result-desc data-v-aad8bf2b">{{f}}</text><button tt:if="{{g}}" class="submit-btn data-v-aad8bf2b" bindtap="{{h}}">查询认证结果</button><button tt:if="{{i}}" class="submit-btn data-v-aad8bf2b" bindtap="{{j}}">重新认证</button><button tt:if="{{k}}" class="submit-btn success data-v-aad8bf2b" bindtap="{{l}}">返回认证中心</button></view>