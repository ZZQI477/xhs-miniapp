<view class="container data-v-1157eb0a"><view class="header data-v-1157eb0a"><text class="title data-v-1157eb0a">重置密码</text><text class="subtitle data-v-1157eb0a">请输入注册时的手机号重置密码</text></view><view class="form-section data-v-1157eb0a"><view class="input-group data-v-1157eb0a"><text class="input-label data-v-1157eb0a">手机号</text><view class="input-wrapper data-v-1157eb0a"><text class="country-code data-v-1157eb0a">+86</text><input class="input-field data-v-1157eb0a" type="number" placeholder="请输入手机号" maxlength="11" value="{{a}}" bindinput="{{b}}"/></view></view><view class="input-group data-v-1157eb0a"><text class="input-label data-v-1157eb0a">验证码</text><view class="input-wrapper code-wrapper data-v-1157eb0a"><input class="input-field data-v-1157eb0a" type="number" placeholder="请输入验证码" maxlength="6" value="{{c}}" bindinput="{{d}}"/><button class="code-btn data-v-1157eb0a" disabled="{{f}}" bindtap="{{g}}">{{e}}</button></view></view><view class="input-group data-v-1157eb0a"><text class="input-label data-v-1157eb0a">新密码</text><view class="input-wrapper data-v-1157eb0a"><input class="input-field data-v-1157eb0a" type="{{h}}" placeholder="请输入新密码(6-20位)" maxlength="20" value="{{i}}" bindinput="{{j}}"/><text class="eye-icon data-v-1157eb0a" bindtap="{{l}}">{{k}}</text></view></view><view class="input-group data-v-1157eb0a"><text class="input-label data-v-1157eb0a">确认密码</text><view class="input-wrapper data-v-1157eb0a"><input class="input-field data-v-1157eb0a" type="{{m}}" placeholder="请再次输入新密码" maxlength="20" value="{{n}}" bindinput="{{o}}"/><text class="eye-icon data-v-1157eb0a" bindtap="{{q}}">{{p}}</text></view></view><button class="submit-btn data-v-1157eb0a" loading="{{r}}" bindtap="{{s}}"> 重置密码 </button><view class="back-login data-v-1157eb0a"><text class="data-v-1157eb0a" bindtap="{{t}}">返回登录</text></view></view></view>