<view class="container data-v-886e8b32"><custom-nav-bar tt:if="{{a}}" class="data-v-886e8b32" u-i="886e8b32-0" bind:__l="__l" u-p="{{a}}"/><view class="nav-bar-placeholder data-v-886e8b32"></view><view tt:if="{{b}}" class="empty data-v-886e8b32"><text class="empty-icon data-v-886e8b32">💝</text><text class="empty-text data-v-886e8b32">暂无记录</text><text class="empty-tip data-v-886e8b32">完善资料，吸引更多人关注你</text><navigator class="empty-btn data-v-886e8b32" url="/pages/profile/edit">完善资料</navigator></view><view tt:else class="list data-v-886e8b32"><view tt:for="{{c}}" tt:for-item="item" tt:key="n" class="list-item data-v-886e8b32" bindtap="{{item.o}}"><image class="avatar data-v-886e8b32" src="{{item.a}}" mode="aspectFill"></image><view class="info data-v-886e8b32"><view class="info-top data-v-886e8b32"><text class="nickname data-v-886e8b32">{{item.b}}</text><text class="{{('gender') + ' ' + 'data-v-886e8b32' + ' ' + (item.d && 'female')}}">{{item.c}}</text></view><text class="desc data-v-886e8b32">{{item.e}}岁 · {{item.f}}cm · {{item.g}}</text><text class="time data-v-886e8b32">{{item.h}}</text></view><view class="right-info data-v-886e8b32"><view class="{{('want-type') + ' ' + 'data-v-886e8b32' + ' ' + item.j}}"> 想看{{item.i}}</view><view tt:if="{{item.k}}" class="{{('status-tag') + ' ' + 'data-v-886e8b32' + ' ' + item.m}}">{{item.l}}</view><view tt:else class="pending-tag data-v-886e8b32"> 待处理 </view></view></view></view><view tt:if="{{d}}" class="load-more data-v-886e8b32"><text tt:if="{{e}}" class="data-v-886e8b32">加载中...</text><text tt:elif="{{f}}" class="data-v-886e8b32">没有更多了</text><text tt:else class="data-v-886e8b32" bindtap="{{g}}">点击加载更多</text></view><view tt:if="{{h}}" class="popup-mask data-v-886e8b32" bindtap="{{i}}"></view><view tt:if="{{j}}" class="popup-content data-v-886e8b32"><view class="popup-header data-v-886e8b32"><text class="popup-title data-v-886e8b32">查看对方资料</text><text class="popup-close data-v-886e8b32" bindtap="{{k}}">×</text></view><view tt:if="{{l}}" class="popup-user data-v-886e8b32"><image class="popup-avatar data-v-886e8b32" src="{{m}}" mode="aspectFill" bindtap="{{n}}"></image><view class="popup-info data-v-886e8b32"><view class="popup-name-row data-v-886e8b32"><text class="popup-name data-v-886e8b32">{{o}}</text><text class="{{('popup-gender') + ' ' + 'data-v-886e8b32' + ' ' + (q && 'female')}}">{{p}}</text></view><text class="popup-desc data-v-886e8b32">{{r}}cm · </text><text class="popup-age data-v-886e8b32">{{s}}岁</text></view><view class="view-profile data-v-886e8b32" bindtap="{{t}}"><text class="data-v-886e8b32">查看主页</text><text class="arrow data-v-886e8b32">›</text></view></view><view class="popup-tip data-v-886e8b32"><text class="tip-icon data-v-886e8b32">💡</text><text class="tip-text data-v-886e8b32">对方想查看你的{{v}}</text></view><view tt:if="{{w}}" class="popup-status data-v-886e8b32"><text class="{{('status-result') + ' ' + 'data-v-886e8b32' + ' ' + y}}">{{x}}</text></view><view tt:if="{{z}}" class="popup-actions data-v-886e8b32"><view class="action-btn reject data-v-886e8b32" bindtap="{{A}}"><text class="data-v-886e8b32">拒绝</text></view><view class="action-btn accept data-v-886e8b32" bindtap="{{B}}"><text class="data-v-886e8b32">同意解锁</text></view></view></view></view>