
/* 定义状态栏高度变量 */
.data-v-79df256d:root {
  --status-bar-height: 0px;
}
.container.data-v-79df256d {
  /* background-image: url('/static/bg1.png'); */
  background-size: cover;
  background-position: center;
  background-repeat: no-repeat;
  min-height: 100vh;
  /* padding-bottom: 120rpx; */
  position: relative;
  z-index: 0;
}

/* 导航栏占位 */
.nav-bar-placeholder.data-v-79df256d {
  height: 165rpx;
}



/* 顶部轮播图 */
.banner.data-v-79df256d {
  width: 100%;
  height: 300rpx;
  margin-bottom: 40rpx;
}
.banner-item.data-v-79df256d {
  position: relative;
  width: 100%;
  height: 300rpx;
  padding: 0 20rpx;
  box-sizing: border-box;
}
.banner-item image.data-v-79df256d {
  width: 100%;
  height: 100%;
  border-radius: 16rpx;
}
.banner-content.data-v-79df256d {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 60rpx;
  color: #FFFFFF;
  text-align: left;
}
.banner-title.data-v-79df256d {
  font-size: 36rpx;
  font-weight: bold;
  margin-bottom: 10rpx;
  display: block;
}
.banner-subtitle.data-v-79df256d {
  font-size: 28rpx;
  margin-bottom: 30rpx;
  display: block;
}
.join-btn.data-v-79df256d {
  background-color: #FF4D4F;
  color: #FFFFFF;
  border: none;
  border-radius: 32rpx;
  padding: 0rpx 24rpx;
  font-size: 24rpx;
  width: auto;
}

/* 自定义指示器 */
.banner-dots.data-v-79df256d {
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 12rpx;
  margin-top: -30rpx;
  margin-bottom: 20rpx;
  position: relative;
  z-index: 10;
}
.banner-dots .dot.data-v-79df256d {
  width: 16rpx;
  height: 6rpx;
  border-radius: 3rpx;
  background-color: rgba(255, 255, 255, 0.5);
  transition: all 0.3s;
}
.banner-dots .dot.active.data-v-79df256d {
  width: 32rpx;
  background-color: #FFFFFF;
}

/* 筛选标签 */
.filter-tabs.data-v-79df256d {
  display: flex;
  align-items: center;
  justify-content: space-between;
  /* background-color: #FFFFFF; */
  padding: 0 20rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
  white-space: nowrap;
  overflow-x: auto;
}
.tab-item.data-v-79df256d {
  font-size: 28rpx;
  padding: 16rpx 24rpx;
  margin-right: 30rpx;
  color: #666666;
  position: relative;
  cursor: pointer;
  transition: all 0.3s;
  white-space: nowrap;
}
.tab-item.active.data-v-79df256d {
  font-size: 30rpx;
  font-weight: bold;
  /* color: #FF4D4F; */
}
.tab-item.active.data-v-79df256d::after {
  content: '';
  position: absolute;
  bottom: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  width: 100rpx;
  height: 8rpx;
  background-color: #8f4dffa8;
  border-radius: 2rpx;
}
.filter-btn.data-v-79df256d {
  margin-left: auto;
  display: flex;
  align-items: center;
  justify-content: center;
  background-color: #FFFFFF;
  border: 2rpx solid #E8E8E8;
  border-radius: 50rpx;
  padding: 0rpx;
  width: 70rpx;
  height: 70rpx;
  font-size: 28rpx;
  box-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.05);
}
.filter-icon.data-v-79df256d {
  width: 32rpx;
  height: 32rpx;
}

/* 用户卡片列表 */
.user-list.data-v-79df256d {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 30rpx;
  padding: 30rpx 50rpx;
  background-color: #FFFFFF;
}

/* 用户卡片 */
.li-item.data-v-79df256d {
  display: flex;
  flex-direction: column;
  margin-bottom: 20rpx;
  background-color: #FFFFFF;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.08);
}
.header-img.data-v-79df256d {
  width: 100%;
  height: 300rpx;
  border-radius: 12rpx 12rpx 0 0;
  margin-bottom: 0;
  position: relative;
}
.age-tag.data-v-79df256d {
  position: absolute;
  top: 0rpx;
  right: 0rpx;
  background-color: #9370DB;
  color: #FFFFFF;
  font-size: 24rpx;
  padding: 8rpx 16rpx;
  border-radius: 0 20rpx 0 20rpx;
  z-index: 1;
}
.user-info.data-v-79df256d {
  padding: 20rpx;
}
.user-name.data-v-79df256d {
  display: flex;
  align-items: center;
  margin-bottom: 12rpx;
  font-size: 28rpx;
  font-weight: bold;
  color: #333333;
}
.gender-icon.data-v-79df256d {
  width: 32rpx;
  height: 32rpx;
  margin-left: 10rpx;
}
.user-city.data-v-79df256d {
  font-size: 24rpx;
  color: #666666;
  margin-bottom: 16rpx;
}

/* 标签样式 */
.user-tags.data-v-79df256d {
  display: flex;
  flex-wrap: wrap;
  gap: 10rpx;
}
.user-tags text.data-v-79df256d {
  background: #DEE4FF;
  color: #384582;
  font-size: 22rpx;
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
  white-space: nowrap;
}
.education.data-v-79df256d {
  font-size: 26rpx;
  color: #6E6E6E;
  text-align: center;
  width: 180rpx;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 解锁全部嘉宾 */
.extra-list.data-v-79df256d {
  grid-column: span 2;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 20rpx;
  width: 100%;
}

/* 模糊头像预览 */
.headers.data-v-79df256d {
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 10rpx;
}
.header-img-parent.data-v-79df256d {
  width: 84rpx;
  height: 84rpx;
  border-radius: 50%;
  background-color: white;
  margin-right: -16rpx;
  padding: 4rpx;
  border: 2rpx solid white;
  box-shadow: 0 2rpx 8rpx rgba(0, 0, 0, 0.1);
  flex-shrink: 0;
}
.header-img-blur.data-v-79df256d {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  filter: blur(8px);
  will-change: filter;
}

/* 解锁按钮 */
.unlock-btn-wrapper.data-v-79df256d {
  display: flex;
  justify-content: center;
  align-items: center;
  width: 260rpx;
  height: 80rpx;
  border-radius: 46rpx;
  margin-top: 30rpx;
  margin-bottom: 40rpx;
  border: 2rpx solid rgba(250, 115, 29, 0.2);
  background-color: transparent;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}
.unlock-btn-wrapper.data-v-79df256d:active {
  background-color: rgba(250, 115, 29, 0.1);
  transform: scale(0.98);
  border-color: rgba(250, 115, 29, 0.4);
}
.unlock-btn-text.data-v-79df256d {
  color: #FA731D;
  font-size: 28rpx;
  font-weight: 500;
}

/* 已脱单案例列表 */
.couple-list.data-v-79df256d {
  padding: 0 50rpx;
  display: flex;
  flex-direction: row;
  flex-wrap: wrap;
  justify-content: space-between;
}
.couple-card.data-v-79df256d {
  width: 310rpx;
  background-color: #F9F9F9;
  border-radius: 20rpx;
  padding: 30rpx 20rpx 38rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-top: 30rpx;
  box-sizing: border-box;
}
.couple-avatar.data-v-79df256d {
  width: 180rpx;
  height: 180rpx;
  margin-bottom: 28rpx;
}
.avatar-blur.data-v-79df256d {
  width: 180rpx;
  height: 180rpx;
  border-radius: 90rpx;
  filter: blur(6rpx);
}
.couple-info.data-v-79df256d {
  text-align: center;
  width: 100%;
}
.couple-name.data-v-79df256d {
  font-size: 30rpx;
  font-weight: bold;
  color: #131313;
  display: block;
  margin-bottom: 20rpx;
  max-width: 270rpx;
  white-space: nowrap;
  overflow: hidden;
  text-overflow: ellipsis;
}
.couple-detail.data-v-79df256d {
  font-size: 26rpx;
  color: #6E6E6E;
  margin-bottom: 20rpx;
  text-align: left;
  margin-left: 20rpx;
}
.couple-detail.data-v-79df256d:last-child {
  margin-bottom: 0;
}

/* 加载更多 */
.load-more.data-v-79df256d {
  text-align: center;
  padding: 40rpx;
  color: #999999;
}

/* 空状态 */
.empty.data-v-79df256d {
  text-align: center;
  padding: 100rpx;
  color: #999999;
}

/* 解锁全部嘉宾卡片 */
.unlock-card.data-v-79df256d {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  display: flex;
  align-items: center;
  justify-content: center;
  cursor: pointer;
  box-shadow: 0 8rpx 24rpx rgba(102, 126, 234, 0.3);
  transition: all 0.3s;
}
.unlock-card.data-v-79df256d:active {
  transform: scale(0.98);
}
.unlock-container.data-v-79df256d {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 100%;
  height: 100%;
  padding: 20rpx;
}
.unlock-icon.data-v-79df256d {
  font-size: 60rpx;
  margin-bottom: 15rpx;
  animation: shake-79df256d 2s infinite;
}
@keyframes shake-79df256d {
0%, 100% { transform: rotate(0deg);
}
25% { transform: rotate(-10deg);
}
75% { transform: rotate(10deg);
}
}
.unlock-text.data-v-79df256d {
  font-size: 28rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-bottom: 10rpx;
}
.unlock-desc.data-v-79df256d {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
}
