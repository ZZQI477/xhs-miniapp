  height: 204rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  overflow: hidden;
}
.activity-content.data-v-178c6e25 {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  min-width: 0;
  height: 170rpx;
}
.activity-title.data-v-178c6e25 {
  -webkit-line-clamp: 2;
